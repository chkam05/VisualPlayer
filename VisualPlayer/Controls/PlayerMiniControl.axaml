<controls:PlayerControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:resources="using:VisualPlayer.Resources"
    x:Class="VisualPlayer.Controls.PlayerMiniControl"
    x:Name="Root"
    x:FieldModifier="private"
    Classes="internal-layout">

    <UserControl.Resources>
        <converters:BrushOpacityConverter x:Key="BrushOpacityConverter" />
        <converters:PlayingToIconConverter x:Key="MiniPlayingToIconConverter" />
        <converters:RepeatModeToIconConverter x:Key="MiniRepeatModeToIconConverter" />
    </UserControl.Resources>
    
    <UserControl.Content>
        <Grid
            x:DataType="contexts:PlayerMiniDataContext"
            Background="Transparent"
            ClipToBounds="True">

            <Border
                x:Name="ContentHost"
                x:FieldModifier="private"
                BorderBrush="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="8"
                MaxHeight="128"
                Padding="4,8">

                <Border.Background>
                    <MultiBinding
                        Converter="{StaticResource BrushOpacityConverter}">

                        <Binding
                            Path="Config.Appearance.ControlBackgroundBrush"
                            Source="{x:Static contexts:ApplicationContext.Instance}" />

                        <Binding
                            Path="Config.MiniPlayer.Opacity"
                            Source="{x:Static contexts:ApplicationContext.Instance}" />
                    </MultiBinding>
                </Border.Background>

                <Border.ContextMenu>
                    <ContextMenu
                        x:Name="PlayerContextMenu"
                        x:FieldModifier="private"
                        Theme="{StaticResource {x:Type ContextMenu}}">

                        <MenuItem
                            x:Name="FullPlayerMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_FULL_PLAYER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Maximize2"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator />

                        <!-- VIEW CONTROL -->

                        <MenuItem
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_STAY_ON_TOP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsChecked="{ReflectionBinding Config.MiniPlayer.StayOnTop, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                            ToggleType="CheckBox">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Pin"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_SHOW_COVER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsChecked="{ReflectionBinding Config.MiniPlayer.ShowCover, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                            ToggleType="CheckBox">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Image"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_SHOW_VISUALIZATION], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsChecked="{ReflectionBinding Config.MiniPlayer.ShowVisualization, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                            ToggleType="CheckBox">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="AudioLines"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator />

                        <!-- PLAYER CONTROLS -->

                        <MenuItem
                            x:Name="PlayMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[COMMON_BUTTON_PLAY], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="{Binding !Player.IsPlaying}">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Play"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem
                            x:Name="PauseMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_PAUSE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="{Binding Player.IsPlaying}">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Pause"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem
                            x:Name="PreviousMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[PLAYER_TOOLTIP_PREVIOUS_TRACK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="SkipBack"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem
                            x:Name="NextMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[PLAYER_TOOLTIP_NEXT_TRACK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                            
                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="SkipForward"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem
                            x:Name="StopMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[PLAYER_TOOLTIP_STOP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Square"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator />
                        
                        <!-- Visualization switch -->
                        <MenuItem
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_VISUALIZATION], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                            
                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="AudioLines"
                                    Size="16" />
                            </MenuItem.Icon>

                            <MenuItem
                                x:Name="RegularVisualizationMenuItem"
                                x:FieldModifier="private"
                                Header="{ReflectionBinding Translations[ENUM_MINIVISUALIZATIONTYPE_REGULAR], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="Regular"
                                ToggleType="Radio" />

                            <MenuItem
                                x:Name="UpsideDownVisualizationMenuItem"
                                x:FieldModifier="private"
                                Header="{ReflectionBinding Translations[ENUM_MINIVISUALIZATIONTYPE_UPSIDE_DOWN], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="UpsideDown"
                                ToggleType="Radio" />

                            <MenuItem
                                x:Name="SingleVisualizationMenuItem"
                                x:FieldModifier="private"
                                Header="{ReflectionBinding Translations[ENUM_MINIVISUALIZATIONTYPE_SINGLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="Single"
                                ToggleType="Radio" />

                            <MenuItem
                                x:Name="CenterFilledVisualizationMenuItem"
                                x:FieldModifier="private"
                                Header="{ReflectionBinding Translations[ENUM_MINIVISUALIZATIONTYPE_CENTER_FILLED], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="CenterFilled"
                                ToggleType="Radio" />

                            <MenuItem
                                x:Name="CenterSingleVisualizationMenuItem"
                                x:FieldModifier="private"
                                Header="{ReflectionBinding Translations[ENUM_MINIVISUALIZATIONTYPE_CENTER_SINGLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="CenterSingle"
                                ToggleType="Radio" />
                        </MenuItem>

                        <Separator />

                        <MenuItem
                            x:Name="CloseApplicationMenuItem"
                            x:FieldModifier="private"
                            Header="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_CLOSE_APPLICATION], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                            <MenuItem.Icon>
                                <LucideIcon
                                    Kind="Power"
                                    Size="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    RowDefinitions="Auto,*"
                    RowSpacing="4">

                    <!-- LEFT RESIZE HANDLE -->
                    <Border
                        x:Name="LeftResizeHandle"
                        x:FieldModifier="private"
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        PointerCaptureLost="ResizeBorder_OnPointerCaptureLost"
                        PointerMoved="ResizeBorder_OnPointerMoved"
                        PointerPressed="ResizeBorder_OnPointerPressed"
                        PointerReleased="ResizeBorder_OnPointerReleased"
                        Theme="{StaticResource PlayerMini.ResizeBorderTheme}">

                        <Border
                            Theme="{StaticResource PlayerMini.ResizeGripTheme}" />
                    </Border>

                    <!-- MINI VISUALIZATION -->
                    <controls:MiniVisualizationControl
                        Core="{ReflectionBinding VisualizationCore, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsMiniVisualizationVisible, ElementName=Root}"
                        Margin="4,0,16,0"
                        VerticalAlignment="Center"
                        VisualizationType="{ReflectionBinding Config.MiniPlayer.VisualizationType, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}" />
                    
                    <!-- TRACK SLIDER -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="6"
                        Grid.Column="2"
                        Grid.Row="0"
                        Margin="0,0,4,0">

                        <TextBlock
                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                            FontSize="16"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            MinWidth="48"
                            Text="{Binding Player.CurrentPositionText}"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                        
                        <Slider
                            x:Name="PositionSlider"
                            x:FieldModifier="private"
                            Grid.Column="1"
                            Maximum="{Binding Player.PositionMaximum}"
                            Minimum="0"
                            Theme="{StaticResource PlayerMini.PositionSliderTheme}"
                            Value="{Binding Position, Mode=TwoWay, ElementName=Root}"
                            VerticalAlignment="Center" />
                        
                        <TextBlock
                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                            FontSize="16"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            MinWidth="48"
                            Text="{Binding Player.DurationText}"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- DATA / CONTROLS -->
                    <Grid
                        ColumnDefinitions="Auto,*"
                        Grid.Column="2"
                        Grid.Row="1"
                        Margin="0,0,4,0">

                        <!-- COVER -->
                        <Border
                            Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            ClipToBounds="True"
                            CornerRadius="6"
                            Grid.Column="0"
                            Height="64"
                            IsVisible="{Binding IsCoverVisible, ElementName=Root}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="64">

                            <Grid>
                                <LucideIcon
                                    HorizontalAlignment="Center"
                                    Kind="Music"
                                    Opacity="0.35"
                                    Size="28"
                                    VerticalAlignment="Center" />

                                <Image
                                    Source="{Binding InfoBar.Cover}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <Grid
                            Grid.Column="1"
                            RowDefinitions="Auto,*"
                            RowSpacing="4">

                            <!-- TITLE -->
                            <components:ScrollTextBlock
                                FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                MinWidth="0"
                                Text="{Binding InfoBar.Title, Converter={StaticResource LatinTransliterationConverter}}"
                                VerticalAlignment="Center" />
                            
                            <Grid
                                ColumnDefinitions="*,Auto,48"
                                Grid.Row="1">

                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    MinWidth="0"
                                    VerticalAlignment="Top">

                                    <!-- ALBUM -->
                                    <Grid
                                        ColumnDefinitions="Auto,*">

                                        <TextBlock
                                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                            FontSize="18"
                                            IsVisible="{Binding AreMetadataLabelsVisible, ElementName=Root}"
                                            Margin="0,0,31,0"
                                            Opacity="0.6"
                                            Text="{Binding InfoBar.AlbumLabel}" />

                                        <TextBlock
                                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                            FontSize="18"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Opacity="0.75"
                                            Text="{Binding InfoBar.Album, Converter={StaticResource LatinTransliterationConverter}}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- AUTHOR -->
                                    <Grid
                                        ColumnDefinitions="Auto,*">

                                        <TextBlock
                                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                            FontSize="18"
                                            IsVisible="{Binding AreMetadataLabelsVisible, ElementName=Root}"
                                            Margin="0,0,9,0"
                                            Opacity="0.6"
                                            Text="{Binding InfoBar.ArtistLabel}" />

                                        <TextBlock
                                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                            FontSize="18"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Opacity="0.75"
                                            Text="{Binding InfoBar.Artist, Converter={StaticResource LatinTransliterationConverter}}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>

                                <!-- BUTTONS -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">

                                    <components:ToggleButtonWithIcon
                                        IsChecked="{Binding Player.IsShuffleEnabled, Mode=TwoWay}"
                                        Kind="Shuffle"
                                        Theme="{StaticResource PlayerMiniControl.ToggleIconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[PLAYERCONTROL_BUTTON_SHUFFLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <components:ButtonWithIcon
                                        x:Name="RepeatButton"
                                        x:FieldModifier="private"
                                        Kind="{Binding Player.RepeatMode, Converter={StaticResource MiniRepeatModeToIconConverter}}"
                                        Theme="{StaticResource PlayerMiniControl.IconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_REPEAT], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <Border
                                        Theme="{StaticResource PlayerControl.SeparatorBorder}" />
                                    
                                    <components:ButtonWithIcon
                                        x:Name="PreviousButton"
                                        x:FieldModifier="private"
                                        Kind="SkipBack"
                                        Theme="{StaticResource PlayerMiniControl.IconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_PREVIOUS_TRACK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <components:ButtonWithIcon
                                        x:Name="PlayPauseButton"
                                        x:FieldModifier="private"
                                        Kind="{Binding Player.IsPlaying, Converter={StaticResource MiniPlayingToIconConverter}}"
                                        Theme="{StaticResource PlayerMiniControl.IconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_PLAY_PAUSE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <components:ButtonWithIcon
                                        x:Name="NextButton"
                                        x:FieldModifier="private"
                                        Kind="SkipForward"
                                        Theme="{StaticResource PlayerMiniControl.IconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_NEXT_TRACK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <components:ButtonWithIcon
                                        x:Name="StopButton"
                                        x:FieldModifier="private"
                                        Kind="Square"
                                        Theme="{StaticResource PlayerMiniControl.IconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_STOP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <Border
                                        Theme="{StaticResource PlayerControl.SeparatorBorder}" />
                                    
                                    <components:ToggleButtonWithIcon
                                        CheckedKind="VolumeX"
                                        IsChecked="{Binding Player.IsMuted, Mode=TwoWay}"
                                        Kind="Volume2"
                                        Theme="{StaticResource PlayerMiniControl.ToggleIconButtonTheme}"
                                        ToolTip.Tip="{ReflectionBinding Translations[VOLUME_TOOLTIP_MUTE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    
                                    <!-- VOLUME -->
                                    <Slider
                                        Margin="4,0"
                                        Maximum="1"
                                        Minimum="0"
                                        Theme="{StaticResource PlayerVolume.SliderTheme}"
                                        Value="{Binding Player.Volume, Mode=TwoWay}"
                                        Width="128" />
                                </StackPanel>

                                <!-- OPTION BUTTONS -->
                                <Grid
                                    Grid.Column="2"
                                    Grid.Row="1"
                                    VerticalAlignment="Bottom">

                                    <Border
                                        BorderBrush="{x:Null}"
                                        BorderThickness="0"
                                        CornerRadius="16"
                                        HorizontalAlignment="Right"
                                        Padding="1"
                                        VerticalAlignment="Bottom">

                                        <Border.Background>
                                            <MultiBinding
                                                Converter="{StaticResource BrushOpacityConverter}">

                                                <Binding
                                                    Path="Config.Appearance.ThemeShadeBackgroundBrush"
                                                    Source="{x:Static contexts:ApplicationContext.Instance}" />

                                                <Binding
                                                    Path="Config.Appearance.InterfaceOpacity"
                                                    Source="{x:Static contexts:ApplicationContext.Instance}" />
                                            </MultiBinding>
                                        </Border.Background>

                                        <components:ToggleButtonWithIcon
                                            CheckedKind="Maximize2"
                                            IsChecked="{Binding IsMiniMode, ElementName=Root, Mode=TwoWay}"
                                            Kind="Minimize2"
                                            Theme="{StaticResource PlayerControl.MiniToggleButtonWithIconTheme}"
                                            ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_TOGGLE_MINI_PLAYER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- RIGHT RESIZE HANDLE -->
                    <Border
                        x:Name="RightResizeHandle"
                        x:FieldModifier="private"
                        Grid.Column="3"
                        Grid.RowSpan="2"
                        Theme="{StaticResource PlayerMini.ResizeBorderTheme}"
                        PointerPressed="ResizeBorder_OnPointerPressed"
                        PointerMoved="ResizeBorder_OnPointerMoved"
                        PointerReleased="ResizeBorder_OnPointerReleased"
                        PointerCaptureLost="ResizeBorder_OnPointerCaptureLost">

                        <Border
                            Theme="{StaticResource PlayerMini.ResizeGripTheme}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </UserControl.Content>

    <UserControl.Styles>
        <Style Selector=":is(controls|PlayerMiniControl)">
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
        </Style>

        <Style Selector=":is(controls|PlayerMiniControl).internal-layout /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
</controls:PlayerControl>
