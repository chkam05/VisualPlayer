<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:resources="using:VisualPlayer.Resources"
    x:Class="VisualPlayer.Controls.PlayerControl"
    x:Name="Root"
    x:FieldModifier="private"
    Classes="internal-layout">

    <UserControl.Resources>
        <converters:PlayingToIconConverter x:Key="PlayingToIconConverter" />
        <converters:RepeatModeToIconConverter x:Key="RepeatModeToIconConverter" />
    </UserControl.Resources>

    <UserControl.Content>
        <Grid
            x:DataType="contexts:PlayerDataContext"
            Background="Transparent"
            ClipToBounds="True">

            <Grid.RowDefinitions>
                <RowDefinition
                    Height="{x:Static resources:Dimensions.AutoHideRevealGridLength}" />

                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="ContentHost"
                x:FieldModifier="private"
                Background="Transparent"
                BorderBrush="{x:Null}"
                BorderThickness="0"
                Grid.Row="1"
                Margin="8"
                MaxHeight="128"
                Padding="0"
                Theme="{StaticResource ControlBorderTheme}"
                VerticalAlignment="Bottom">

                <Grid
                    RowDefinitions="Auto,*">

                    <!-- TRACK SLIDER -->
                    <Grid
                        Grid.Row="0">

                        <Slider
                            Grid.Column="1"
                            Maximum="{Binding PositionMaximum}"
                            Minimum="0"
                            Theme="{StaticResource PlayerPosition.SliderTheme}"
                            Value="{Binding Position, Mode=TwoWay, ElementName=Root}"
                            VerticalAlignment="Center"
                            x:Name="PositionSlider"
                            x:FieldModifier="private" />
                    </Grid>

                    <!-- CONTROLS -->
                    <Border
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8"
                        Grid.Row="1"
                        Margin="0"
                        Padding="8"
                        Theme="{StaticResource ControlBorderTheme}">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto,*,Auto"
                            RowDefinitions="Auto,*,Auto">

                            <!-- CURRENT TIME -->
                            <TextBlock
                                FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                FontSize="20"
                                Grid.Column="0"
                                Grid.Row="0"
                                HorizontalAlignment="Left"
                                MinWidth="64"
                                Text="{Binding CurrentPositionText}"
                                TextAlignment="Left"
                                VerticalAlignment="Top" />
                            
                            <!-- BUTTONS -->
                            <StackPanel
                                Grid.Column="2"
                                Grid.RowSpan="3"
                                Margin="0,8"
                                Orientation="Horizontal"
                                Spacing="8">

                                <components:ToggleButtonWithIcon
                                    IsChecked="{Binding IsShuffleEnabled, Mode=TwoWay}"
                                    Kind="Shuffle"
                                    Theme="{StaticResource PlayerControl.ToggleIconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYERCONTROL_BUTTON_SHUFFLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                
                                <components:ButtonWithIcon
                                    x:Name="RepeatButton"
                                    x:FieldModifier="private"
                                    Kind="{Binding RepeatMode, Converter={StaticResource RepeatModeToIconConverter}}"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_REPEAT], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                
                                <Border
                                    Theme="{StaticResource PlayerControl.SeparatorBorder}" />
                                
                                <components:ButtonWithIcon
                                    x:Name="PreviousButton"
                                    x:FieldModifier="private"
                                    Kind="SkipBack"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_PREVIOUS_TRACK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                
                                <components:ButtonWithIcon
                                    x:Name="PlayPauseButton"
                                    x:FieldModifier="private"
                                    Kind="{Binding IsPlaying, Converter={StaticResource PlayingToIconConverter}}"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_PLAY_PAUSE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                
                                <components:ButtonWithIcon
                                    x:Name="NextButton"
                                    x:FieldModifier="private"
                                    Kind="SkipForward"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_NEXT_TRACK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                
                                <components:ButtonWithIcon
                                    x:Name="StopButton"
                                    x:FieldModifier="private"
                                    Kind="Square"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_STOP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                                
                                <Border
                                    Theme="{StaticResource PlayerControl.SeparatorBorder}" />
                                
                                <components:ButtonWithIcon
                                    x:Name="SpeedButton"
                                    x:FieldModifier="private"
                                    Kind="Gauge"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_PLAYBACK_SPEED], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />

                                <components:ButtonWithIcon
                                    x:Name="VolumeButton"
                                    x:FieldModifier="private"
                                    Kind="Volume2"
                                    Theme="{StaticResource PlayerControl.IconButtonTheme}"
                                    ToolTip.Tip="{ReflectionBinding Translations[PLAYERCONTROL_BUTTON_VOLUME], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                            </StackPanel>

                            <!-- DURATION / REVERSE TIME -->
                            <TextBlock
                                FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                                FontSize="20"
                                Grid.Column="4"
                                Grid.Row="0"
                                HorizontalAlignment="Right"
                                MinWidth="64"
                                Text="{Binding DurationText}"
                                TextAlignment="Right"
                                VerticalAlignment="Top" />
                            
                            <!-- MINI PLAYER SWITCH BUTTON -->
                            <components:ToggleButtonWithIcon
                                CheckedKind="Maximize2"
                                Grid.Column="4"
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding IsMiniMode, ElementName=Root, Mode=TwoWay}"
                                Kind="Minimize2"
                                Theme="{StaticResource PlayerControl.MiniToggleButtonWithIconTheme}"
                                ToolTip.Tip="{ReflectionBinding Translations[PLAYER_TOOLTIP_TOGGLE_MINI_PLAYER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </UserControl.Content>

    <UserControl.Styles>
        <Style Selector=":is(controls|PlayerControl)">
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
        </Style>

        <Style Selector=":is(controls|PlayerControl).internal-layout /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
</UserControl>
