<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:resources="using:VisualPlayer.Resources"
    x:Class="VisualPlayer.Controls.InfoBarControl"
    x:Name="Root"
    x:FieldModifier="private"
    Classes="internal-layout">
    
    <UserControl.Content>
        <Grid
            x:DataType="contexts:InfoBarContext"
            Background="Transparent"
            ClipToBounds="False" >

            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                
                <RowDefinition
                    Height="{x:Static resources:Dimensions.AutoHideRevealGridLength}" />
            </Grid.RowDefinitions>

            <Border
                x:Name="ContentHost"
                x:FieldModifier="private"
                Padding="8"
                Grid.Row="0"
                Margin="8"
                MaxHeight="96"
                Theme="{StaticResource ControlBorderTheme}"
                VerticalAlignment="Top" >

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12">

                    <!-- COVER -->
                    <Border
                        Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        ClipToBounds="True"
                        CornerRadius="6"
                        Grid.Column="0"
                        Height="64"
                        Width="64">

                        <Grid>
                            <LucideIcon
                                HorizontalAlignment="Center"
                                Kind="Music"
                                Opacity="0.35"
                                Size="24"
                                VerticalAlignment="Center" />

                            <Image
                                Source="{Binding Cover}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- TITLE / ALBUM / AUTHOR -->
                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center">

                        <!-- Title -->
                        <TextBlock
                            FontFamily="{StaticResource ElectronicDisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            MinWidth="0"
                            Text="{Binding Title, Converter={StaticResource LatinTransliterationConverter}}"
                            TextTrimming="CharacterEllipsis" />

                        <!-- Album -->
                        <Grid
                            ColumnDefinitions="Auto,*">

                            <TextBlock
                                FontFamily="{StaticResource ElectronicDisplayFontFamily}"
                                FontSize="16"
                                Margin="0,0,5,0"
                                Opacity="0.6"
                                Text="{Binding AlbumLabel}" />

                            <TextBlock
                                FontFamily="{StaticResource ElectronicDisplayFontFamily}"
                                FontSize="16"
                                Grid.Column="1"
                                MinWidth="0"
                                Opacity="0.75"
                                Text="{Binding Album, Converter={StaticResource LatinTransliterationConverter}}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- Author -->
                        <Grid
                            ColumnDefinitions="Auto,*">

                            <TextBlock
                                FontFamily="{StaticResource ElectronicDisplayFontFamily}"
                                FontSize="16"
                                Margin="0,0,5,0"
                                Opacity="0.6"
                                Text="{Binding ArtistLabel}" />
                            
                            <TextBlock
                                FontFamily="{StaticResource ElectronicDisplayFontFamily}"
                                FontSize="16"
                                Grid.Column="1"
                                MinWidth="0"
                                Opacity="0.75"
                                Text="{Binding Artist, Converter={StaticResource LatinTransliterationConverter}}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>

                    <!-- TIME -->
                    <StackPanel
                        Grid.Column="2"
                        Margin="16,0"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">

                        <TextBlock
                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                            FontSize="20"
                            MinWidth="48"
                            Text="{Binding Player.CurrentPositionText}"
                            TextAlignment="Right" />
                        
                        <TextBlock
                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                            FontSize="20"
                            Text="/" />
                        
                        <TextBlock
                            FontFamily="{StaticResource Lcd14DisplayFontFamily}"
                            FontSize="20"
                            MinWidth="48"
                            Text="{Binding Player.TotalDurationText}"
                            TextAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </UserControl.Content>

    <UserControl.Styles>
        <Style Selector=":is(controls|InfoBarControl)">
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
            <Setter Property="MinWidth" Value="{x:Static resources:Dimensions.InfoBarMinimumWidth}" />
        </Style>

        <Style Selector=":is(controls|InfoBarControl).internal-layout /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
</UserControl>
