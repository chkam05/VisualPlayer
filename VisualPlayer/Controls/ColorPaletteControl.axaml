<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:configViewModels="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Controls.ColorPaletteControl"
    x:Name="Root"
    x:FieldModifier="private"
    Classes="internal-layout">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="ColorPaletteItemsPanel">
            <WrapPanel
                Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Color Item DataTemplate -->
        <DataTemplate x:Key="AccentColorItemDataTemplate" DataType="configViewModels:AccentColorViewModel" x:DataType="configViewModels:AccentColorViewModel">
            <Border
                Background="{Binding Brush}"
                CornerRadius="5"
                Height="40"
                ToolTip.Tip="{Binding Name}"
                Width="40" />
        </DataTemplate>

    </UserControl.Resources>
    
    <UserControl.Content>
        <StackPanel
            Spacing="12">

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding Title, Mode=OneWay, ElementName=Root}" />
            
            <!-- STATIC COLOR PALETTE -->
            <ListBox
                x:Name="PaletteList"
                x:FieldModifier="private"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerTheme="{StaticResource ColorPalette.ListBoxItemTheme}"
                ItemsPanel="{StaticResource ColorPaletteItemsPanel}"
                ItemsSource="{ReflectionBinding PaletteItems, ElementName=Root}"
                Padding="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="Single">

                <ListBox.DataTemplates>
                    <StaticResource
                        ResourceKey="AccentColorItemDataTemplate" />
                </ListBox.DataTemplates>
            </ListBox>

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,8,0,0"
                Text="{ReflectionBinding Translations[COLORPALETTE_LABEL_LAST_USED], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
            
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">

                <!-- RECENT COLORS PALETTE -->
                <ListBox
                    x:Name="RecentList"
                    x:FieldModifier="private"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerTheme="{StaticResource ColorPalette.ListBoxItemTheme}"
                    ItemTemplate="{StaticResource AccentColorItemDataTemplate}"
                    ItemsPanel="{StaticResource ColorPaletteItemsPanel}"
                    ItemsSource="{ReflectionBinding RecentColors, ElementName=Root}"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="Single" />
                
                <components:ButtonWithIcon
                    x:Name="AddColorButton"
                    x:FieldModifier="private"
                    Grid.Column="1"
                    Height="40"
                    Kind="Plus"
                    Margin="4"
                    Theme="{StaticResource AccentButtonWithIconTheme}"
                    ToolTip.Tip="{ReflectionBinding Translations[COLORPALETTE_BUTTON_ADD_COLOR], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Width="40" />
            </Grid>
        </StackPanel>
    </UserControl.Content>

    <UserControl.Styles>
        <Style Selector=":is(controls|ColorPaletteControl)">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector=":is(controls|ColorPaletteControl).internal-layout /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
</UserControl>
