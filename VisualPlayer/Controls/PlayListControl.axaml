<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:viewModels="using:VisualPlayer.ViewModels"
    x:Class="VisualPlayer.Controls.PlayListControl"
    x:Name="Root"
    x:FieldModifier="private"
    Classes="internal-layout">

    <UserControl.Resources>

        <!-- TrackItem DataTemplate -->
        <DataTemplate x:Key="TrackItemDataTemplate" x:DataType="viewModels:TrackViewModel">
            <Border
                Classes="TrackItem"
                DoubleTapped="TrackItem_DoubleTapped"
                PointerPressed="TrackItem_PointerPressed"
                Background="Transparent"
                CornerRadius="6"
                MinHeight="64"
                Padding="6">

                <Grid
                    ColumnDefinitions="Auto,Auto,48,*,Auto,Auto"
                    ColumnSpacing="10">

                    <Border
                        x:Name="PART_DropBefore"
                        Background="{ReflectionBinding Config.Appearance.AccentColorBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        Grid.ColumnSpan="6"
                        Height="2"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Margin="0,-7,0,0"
                        VerticalAlignment="Top" />

                    <Border
                        x:Name="PART_DropAfter"
                        Background="{ReflectionBinding Config.Appearance.AccentColorBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        Grid.ColumnSpan="6"
                        Height="2"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Margin="0,0,0,-7"
                        VerticalAlignment="Bottom" />

                    <!-- REORDER HANDLER -->
                    <Border
                        x:Name="PART_ReorderHandle"
                        Background="Transparent"
                        Cursor="Hand"
                        Grid.Column="0"
                        VerticalAlignment="Stretch"
                        Width="18">

                        <LucideIcon
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Kind="GripVertical"
                            Opacity="0.55"
                            Size="18"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- CHECKBOX -->
                    <CheckBox
                        Grid.Column="1"
                        IsVisible="{Binding IsSelectionMode}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                    
                    <!-- COVER -->
                    <Border
                        Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        ClipToBounds="True"
                        CornerRadius="5"
                        Grid.Column="2"
                        Height="48"
                        Width="48">

                        <Grid>

                            <!-- Icon fallback -->
                            <LucideIcon
                                Foreground="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                Kind="Music"
                                Opacity="0.35"
                                Size="20"
                                VerticalAlignment="Center" />

                            <!-- Cover -->
                            <Image
                                Source="{Binding Cover}"
                                Stretch="UniformToFill" />

                            <!-- Currently playing overlay -->
                            <Border
                                Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                IsVisible="{Binding IsCurrentPlaying}">

                                <LucideIcon
                                    Foreground="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    Kind="Play"
                                    Size="20"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- TITLE / ALBUM / ARTIST -->
                    <StackPanel
                        Grid.Column="3"
                        ClipToBounds="True"
                        Spacing="3"
                        VerticalAlignment="Center">

                        <!-- Title -->
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />

                        <Grid
                            ColumnDefinitions="*,Auto,*"
                            ColumnSpacing="4"
                            HorizontalAlignment="Left">

                            <!-- Album -->
                            <TextBlock
                                FontSize="12"
                                Opacity="0.65"
                                Text="{Binding Album}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                FontSize="12"
                                Grid.Column="1"
                                Opacity="0.4"
                                Text="/" />

                            <!-- Artist -->
                            <TextBlock
                                FontSize="12"
                                Grid.Column="2"
                                Opacity="0.65"
                                Text="{Binding Artist}"
                                TextTrimming="CharacterEllipsis" />

                        </Grid>
                    </StackPanel>

                    <!-- DURATION -->
                    <TextBlock
                        FontSize="12"
                        Grid.Column="4"
                        Margin="10,0"
                        Opacity="0.7"
                        Text="{Binding DurationText}"
                        VerticalAlignment="Center" />
                    
                    <!-- OPTIONS -->
                    <components:ButtonWithIcon
                        x:Name="PART_OptionsButton"
                        Click="TrackOptionsButton_Click"
                        CornerRadius="16"
                        Grid.Column="5"
                        Height="32"
                        Kind="Ellipsis"
                        Theme="{StaticResource ColorizedButtonWithIconTheme}"
                        ToolTip.Tip="{ReflectionBinding Translations[COMMON_BUTTON_OPTIONS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Width="32">

                        <components:ButtonWithIcon.ContextMenu>
                            <ContextMenu>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[COMMON_BUTTON_OPEN], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="Play"
                                    Click="TrackPlayMenuItem_Click">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="Play"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[COMMON_MOVE_UP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="MoveUp"
                                    Click="TrackMoveMenuItem_Click">
                                    
                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ArrowUp"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[COMMON_MOVE_DOWN], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="MoveDown"
                                    Click="TrackMoveMenuItem_Click">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ArrowDown"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[PLAYLIST_ITEM_ITEM_MOVE_TO_THE_VERY_TOP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="MoveTop"
                                    Click="TrackMoveMenuItem_Click">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ChevronsUp"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[PLAYLIST_ITEM_ITEM_MOVE_TO_THE_VERY_BOTTOM], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="MoveBottom"
                                    Click="TrackMoveMenuItem_Click">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ChevronsDown"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[COMMON_BUTTON_DELETE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="Remove"
                                    Click="TrackRemoveMenuItem_Click">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="Trash"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </components:ButtonWithIcon.ContextMenu>
                    </components:ButtonWithIcon>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Content>
        <Border
            x:DataType="viewModels:PlayListViewModel"
            x:Name="PlayListHost"
            x:FieldModifier="private"
            Background="Transparent"
            BorderThickness="0"
            ClipToBounds="True"
            CornerRadius="0">

            <Grid
                RowDefinitions="Auto,*">

                <!-- HEADER -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="6"
                    Grid.Row="0"
                    Margin="10,10,0,10">

                    <!-- PLAYLIST TITLE -->
                    <StackPanel
                        Grid.Column="0"
                        Spacing="2"
                        VerticalAlignment="Center">

                        <TextBlock
                            FontSize="12"
                            Opacity="0.5"
                            Text="{ReflectionBinding Translations[PLAYLISTCONTROL_HEADER_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
                        
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <components:ButtonWithIcon
                        x:Name="MoreButton"
                        x:FieldModifier="private"
                        CornerRadius="16"
                        Grid.Column="1"
                        Height="32"
                        Kind="Ellipsis"
                        Theme="{StaticResource PlayList.IconButtonTheme}"
                        ToolTip.Tip="{ReflectionBinding Translations[PLAYLIST_TOOLTIP_PLAYLIST_OPTIONS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        VerticalAlignment="Top"
                        Width="32">

                        <components:ButtonWithIcon.ContextMenu>
                            <ContextMenu
                                Placement="BottomEdgeAlignedRight">

                                <MenuItem
                                    Header="{ReflectionBinding Translations[WINDOW_MAIN_OPEN_PLAYLIST_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="OpenPlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="FolderOpen"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[VIEW_PLAYLISTS_SAVE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="SavePlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="Save"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="{ReflectionBinding Translations[PLAYLIST_ITEM_EXPORT_PLAYLIST], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="ExportPlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="FileOutput"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator />

                                <MenuItem
                                    Header="{ReflectionBinding Translations[PLAYLIST_ITEM_CLEAR_PLAYLIST], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                    Tag="ClearPlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ListX"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator />

                                <MenuItem
                                    Command="{Binding SelectCommand}"
                                    Header="{Binding SelectionButtonText}">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ListChecks"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Command="{Binding DeleteCommand}"
                                    Header="{ReflectionBinding Translations[COMMON_BUTTON_DELETE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="Trash"
                                            Size="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </components:ButtonWithIcon.ContextMenu>
                    </components:ButtonWithIcon>

                    <components:ButtonWithIcon
                        x:Name="CloseButton"
                        x:FieldModifier="private"
                        CornerRadius="16"
                        Grid.Column="2"
                        Height="32"
                        Kind="X"
                        Theme="{StaticResource PlayList.IconButtonTheme}"
                        ToolTip.Tip="{ReflectionBinding Translations[DIALOG_BUTTON_CLOSE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        VerticalAlignment="Top"
                        Width="32" />
                </Grid>

                <!-- CONTENT -->
                <Grid
                    Grid.Column="0"
                    Grid.Row="1"
                    RowDefinitions="Auto,*"
                    HorizontalAlignment="Stretch">

                    <!-- ACTION BAR -->
                    <Border
                        BorderBrush="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        BorderThickness="0,0,0,1"
                        Grid.Row="0"
                        Margin="10,0,0,0"
                        Padding="0,8">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">

                            <!-- SEARCH BOX -->
                            <TextBox
                                Text="{Binding SearchPhrase, Mode=TwoWay}"
                                Theme="{StaticResource TextBoxTheme}"
                                PlaceholderText="{ReflectionBinding Translations[PLAYLISTCONTROL_ACTION_SEARCH_PLACEHOLDER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            
                            <!-- SORT BUTTON -->
                            <components:ButtonWithIcon
                                x:Name="SortButton"
                                x:FieldModifier="private"
                                Grid.Column="1"
                                Gap="6"
                                IconPosition="Left"
                                Kind="ArrowUpDown"
                                Theme="{StaticResource PlayList.TextButtonTheme}"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="2">

                                    <TextBlock
                                        Text="{ReflectionBinding Translations[COMMON_BUTTON_SORT], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                        VerticalAlignment="Center" />

                                    <LucideIcon
                                        Kind="ChevronDown"
                                        Size="14"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                
                                <components:ButtonWithIcon.ContextMenu>
                                    <ContextMenu
                                        Placement="BottomEdgeAlignedLeft">

                                        <!-- Sort Title -->
                                        <MenuItem
                                            Header="{ReflectionBinding Translations[VIEW_LIBRARY_MANAGER_ITEM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                            
                                            <MenuItem.Icon>
                                                <LucideIcon
                                                    Kind="ALargeSmall"
                                                    Size="16" />
                                            </MenuItem.Icon>
                                            
                                            <MenuItem
                                                Command="{Binding SortTitleAscendingCommand}"
                                                Header="{ReflectionBinding Translations[COMMON_SORT_ASCENDING], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                                
                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowUpAZ"
                                                        Size="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            
                                            <MenuItem
                                                Command="{Binding SortTitleDescendingCommand}"
                                                Header="{ReflectionBinding Translations[COMMON_SORT_DESCENDING], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                                
                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowDownZA"
                                                        Size="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuItem>
                                        
                                        <!-- Sort Album -->
                                        <MenuItem
                                            Header="{ReflectionBinding Translations[PLAYLIST_ITEM_ALBUM], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                            
                                            <MenuItem.Icon>
                                                <LucideIcon
                                                    Kind="DiscAlbum"
                                                    Size="16" />
                                            </MenuItem.Icon>
                                            
                                            <MenuItem
                                                Command="{Binding SortAlbumAscendingCommand}"
                                                Header="{ReflectionBinding Translations[COMMON_SORT_ASCENDING], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                                
                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowUpAZ"
                                                        Size="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            
                                            <MenuItem
                                                Command="{Binding SortAlbumDescendingCommand}"
                                                Header="{ReflectionBinding Translations[COMMON_SORT_DESCENDING], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                                
                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowDownZA"
                                                        Size="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuItem>
                                        
                                        <!-- Sort Artist -->
                                        <MenuItem
                                            Header="{ReflectionBinding Translations[PLAYLIST_ITEM_ARTIST], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                            
                                            <MenuItem.Icon>
                                                <LucideIcon
                                                    Kind="UserRound"
                                                    Size="16" />
                                            </MenuItem.Icon>
                                            
                                            <MenuItem
                                                Command="{Binding SortArtistAscendingCommand}"
                                                Header="{ReflectionBinding Translations[COMMON_SORT_ASCENDING], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                                
                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowUpAZ"
                                                        Size="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            
                                            <MenuItem
                                                Command="{Binding SortArtistDescendingCommand}"
                                                Header="{ReflectionBinding Translations[COMMON_SORT_DESCENDING], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">
                                                
                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowDownZA"
                                                        Size="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuItem>
                                    </ContextMenu>
                                </components:ButtonWithIcon.ContextMenu>
                            </components:ButtonWithIcon>
                        </Grid>
                    </Border>
                    
                    <!-- TRACK LIST -->
                    <ListBox
                        x:Name="TrackList"
                        x:FieldModifier="private"
                        Grid.Row="1"
                        ItemTemplate="{StaticResource TrackItemDataTemplate}"
                        ItemsSource="{Binding VisibleTracks}"
                        Margin="10,0,0,10"
                        SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                        Theme="{StaticResource PlayList.TracksListBoxTheme}" />

                    <!-- DRAG PREVIEW -->
                    <Canvas
                        Grid.Row="1"
                        IsHitTestVisible="False"
                        ZIndex="10">

                        <ContentControl
                            x:Name="DragPreview"
                            x:FieldModifier="private"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Opacity="0.9"
                            ContentTemplate="{StaticResource TrackItemDataTemplate}" />
                    </Canvas>
                </Grid>
            </Grid>
        </Border>
    </UserControl.Content>

    <UserControl.Styles>
        <Style Selector=":is(controls|PlayListControl)">
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
        </Style>

        <Style Selector=":is(controls|PlayListControl).internal-layout /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
</UserControl>
