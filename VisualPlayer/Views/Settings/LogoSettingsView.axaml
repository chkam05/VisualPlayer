<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:config="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Views.Settings.LogoSettingsView">

    <UserControl.Resources>
        <converters:OpacityToPercentageConverter x:Key="OpacityToPercentageConverter"/>
    </UserControl.Resources>

    <StackPanel
        Spacing="8">

        <!-- HEADER -->
        
        <Grid
            ColumnDefinitions="*,Auto">

            <StackPanel
                Spacing="4">

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_NAV_LOGO], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Click="ResetButton_Click"
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>

        <!-- SETTINGS -->

        <!-- Show Logo -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_ENABLED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Eye"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_ENABLED_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Logo.Enabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>

        <!-- Border Color (V) -->
        <components:SettingsExpandControl
            Icon="PenLine"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_BORDER_COLOR_1], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <controls:ColorPaletteControl
                RecentAccentColors="{ReflectionBinding Config.Appearance.RecentAccentColors, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                SelectedColor="{ReflectionBinding Config.Logo.BorderColor1, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_BORDER_COLOR_1], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </components:SettingsExpandControl>

        <!-- Border Color (P) -->
        <components:SettingsExpandControl
            Icon="PenLine"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_BORDER_COLOR_2], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <controls:ColorPaletteControl
                RecentAccentColors="{ReflectionBinding Config.Appearance.RecentAccentColors, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                SelectedColor="{ReflectionBinding Config.Logo.BorderColor2, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_BORDER_COLOR_2], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </components:SettingsExpandControl>

        <!-- Fill Color (V) -->
        <components:SettingsExpandControl
            Icon="PaintBucket"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_FILL_COLOR_1], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <controls:ColorPaletteControl
                RecentAccentColors="{ReflectionBinding Config.Appearance.RecentAccentColors, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                SelectedColor="{ReflectionBinding Config.Logo.FillColor1, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_FILL_COLOR_1], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </components:SettingsExpandControl>

        <!-- Fill Color (P) -->
        <components:SettingsExpandControl
            Icon="PaintBucket"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_FILL_COLOR_2], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <controls:ColorPaletteControl
                RecentAccentColors="{ReflectionBinding Config.Appearance.RecentAccentColors, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                SelectedColor="{ReflectionBinding Config.Logo.FillColor2, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_TITLE_FILL_COLOR_2], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </components:SettingsExpandControl>

        <!-- Transparency -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Layers2"
            Title="{ReflectionBinding Translations[COMMON_OPACITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <Grid ColumnDefinitions="48,180" ColumnSpacing="8">
                <TextBlock
                    HorizontalAlignment="Right"
                    Text="{ReflectionBinding Config.Logo.Opacity, Source={x:Static contexts:ApplicationContext.Instance}, Converter={StaticResource OpacityToPercentageConverter}, Mode=OneWay}"
                    VerticalAlignment="Center"/>

                <Slider
                    Grid.Column="1"
                    Maximum="{x:Static config:LogoConfig.OPACITY_MAXIMUM}"
                    Minimum="{x:Static config:LogoConfig.OPACITY_MINIMUM}"
                    SmallChange="{x:Static config:LogoConfig.OPACITY_SMALL_CHANGE}"
                    Theme="{StaticResource SliderTheme}"
                    Value="{ReflectionBinding Config.Logo.Opacity, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
            </Grid>
        </components:SettingsControl>

        <!-- Animation (Visualization) -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_ANIMATION_ENABLED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ImagePlay"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_ANIMATION_ENABLED_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Logo.AnimationEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>

        <!-- Animation (Visualization) Sensitivity -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_SENSITIVITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Gauge"
            IsVisible="{ReflectionBinding Config.Logo.AnimationEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_SENSITIVITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static config:LogoConfig.ANIMATION_SENSITIVITY_INCREMENT}"
                Maximum="{x:Static config:LogoConfig.ANIMATION_SENSITIVITY_MAXIMUM}"
                Minimum="{x:Static config:LogoConfig.ANIMATION_SENSITIVITY_MINIMUM}"
                Suffix="%"
                Value="{ReflectionBinding Config.Logo.Sensitivity, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>

        <!-- Animation (Visualization) Scale -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_SCALE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Scaling"
            IsVisible="{ReflectionBinding Config.Logo.AnimationEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_SCALE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static config:LogoConfig.ANIMATION_SCALE_INCREMENT}"
                Maximum="{x:Static config:LogoConfig.ANIMATION_SCALE_MAXIMUM}"
                Minimum="{x:Static config:LogoConfig.ANIMATION_SCALE_MINIMUM}"
                Suffix="%"
                Value="{ReflectionBinding Config.Logo.Scale, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>

        <!-- Animation (Visualization) Speed -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_CONTRACTION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ClockFading"
            IsVisible="{ReflectionBinding Config.Logo.AnimationEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_CONTRACTION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static config:LogoConfig.ANIMATION_CONTRACTION_INCREMENT}"
                Maximum="{x:Static config:LogoConfig.ANIMATION_CONTRACTION_MAXIMUM}"
                Minimum="{x:Static config:LogoConfig.ANIMATION_CONTRACTION_MINIMUM}"
                Suffix=" /s"
                Value="{ReflectionBinding Config.Logo.Contraction, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>

        <!-- Animation (Visualization) Freq Start -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_MINIMUM_FREQUENCY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="AudioWaveform"
            IsVisible="{ReflectionBinding Config.Logo.AnimationEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_MINIMUM_FREQUENCY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static config:LogoConfig.ANIMATION_FREQUENCY_INCREMENT}"
                Maximum="{x:Static config:LogoConfig.ANIMATION_FREQUENCY_MAXIMUM}"
                Minimum="{x:Static config:LogoConfig.ANIMATION_FREQUENCY_MINIMUM}"
                Suffix=" Hz"
                Value="{ReflectionBinding Config.Logo.MinimumFrequency, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>

        <!-- Animation (Visualization) Freq End -->
        <components:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_MAXIMUM_FREQUENCY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="AudioWaveform"
            IsVisible="{ReflectionBinding Config.Logo.AnimationEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LOGO_MAXIMUM_FREQUENCY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static config:LogoConfig.ANIMATION_FREQUENCY_INCREMENT}"
                Maximum="{x:Static config:LogoConfig.ANIMATION_FREQUENCY_MAXIMUM}"
                Minimum="{x:Static config:LogoConfig.ANIMATION_FREQUENCY_MINIMUM}"
                Suffix=" Hz"
                Value="{ReflectionBinding Config.Logo.MaximumFrequency, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </components:SettingsControl>
    </StackPanel>
</UserControl>
