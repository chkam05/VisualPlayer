<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:viewModels="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Views.Settings.PlayerSettingsView">

    <StackPanel
        Spacing="8">

        <Grid
            ColumnDefinitions="*,Auto">

            <StackPanel
                Spacing="4">

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_NAV_PLAYER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Click="ResetButton_Click"
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_SHOW_REMAINING_TIME_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="TimerReset"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_SHOW_REMAINING_TIME_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Player.ShowRemainingTime, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_SPEED_PRESETS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Gauge"
            Title="{ReflectionBinding Translations[PLAYER_TOOLTIP_PLAYBACK_SPEED], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="8">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET1_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Gauge"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET1_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MAXIMUM}"
                        Minimum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MINIMUM}"
                        Suffix="%"
                        Value="{ReflectionBinding Config.Player.PlaybackSpeedPreset1, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET2_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Gauge"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET2_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MAXIMUM}"
                        Minimum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MINIMUM}"
                        Suffix="%"
                        Value="{ReflectionBinding Config.Player.PlaybackSpeedPreset2, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET3_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Gauge"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET3_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MAXIMUM}"
                        Minimum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MINIMUM}"
                        Suffix="%"
                        Value="{ReflectionBinding Config.Player.PlaybackSpeedPreset3, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET4_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Gauge"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAYBACK_SPEED_PRESET4_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MAXIMUM}"
                        Minimum="{x:Static viewModels:PlayerConfig.PLAYBACK_SPEED_MINIMUM}"
                        Suffix="%"
                        Value="{ReflectionBinding Config.Player.PlaybackSpeedPreset4, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_CROSSFADE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="CassetteTape"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_TITLE_SMOOTH_TRANSITION], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="8">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_CROSSFADE_ENABLED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ToggleRight"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_CROSSFADE_ENABLED_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Player.CrossfadeEnabled, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_CROSSFADE_DURATION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ClockFading"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_CROSSFADE_DURATION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static viewModels:PlayerConfig.CROSSFADE_DURATION_MAXIMUM}"
                        Minimum="{x:Static viewModels:PlayerConfig.CROSSFADE_DURATION_MINIMUM}"
                        Suffix=" s"
                        Value="{ReflectionBinding Config.Player.CrossfadeDuration, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_REMEMBER_LAST_PLAY_LIST_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ListRestart"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_REMEMBER_LAST_PLAY_LIST_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Player.RememberLastPlayList, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAY_ON_STARTUP_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="CirclePlay"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAY_ON_STARTUP_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Player.PlayOnStartup, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAY_AFTER_ADDING_FILES_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="FilePlus"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_PLAYER_PLAY_AFTER_ADDING_FILES_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Player.PlayAfterAddingFiles, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>
    </StackPanel>
</UserControl>
