<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:local="using:VisualPlayer.Views.Settings"
    xmlns:viewModelConfig="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Views.Settings.AppearanceSettingsView"
    x:DataType="local:AppearanceSettingsView"
    x:Name="Root">

    <UserControl.Resources>
        <converters:ApplicationThemeToTitleConverter x:Key="ApplicationThemeToTitleConverter"/>
        <converters:ColorizationLevelToTitleConverter x:Key="ColorizationLevelToTitleConverter"/>
        <converters:InfoBarDisplayModeToTitleConverter x:Key="InfoBarDisplayModeToTitleConverter"/>
        <converters:OpacityToPercentageConverter x:Key="OpacityToPercentageConverter"/>
        <converters:ImageFillModeToTitleConverter x:Key="ImageFillModeToTitleConverter"/>
        <converters:WindowBackgroundModeToTitleConverter x:Key="WindowBackgroundModeToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_NAV_APPEARANCE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Click="ResetButton_Click"
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>
        
        <!-- THEME -->
        
        <controls:SettingsControl
            Icon="Paintbrush"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_THEME_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_THEME_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding Themes, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.Appearance.Theme, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ApplicationThemeToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </controls:SettingsControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_COLORIZATION_LEVEL_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="PaintBucket"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_COLORIZATION_LEVEL_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding ColorizationLevels, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.Appearance.ColorizationLevel, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ColorizationLevelToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- ACCENT COLOR -->

        <controls:SettingsExpandControl
            Icon="Palette"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_TITLE_ACCENT_COLOR], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_ACCENT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <controls:ColorPaletteControl
                RecentAccentColors="{ReflectionBinding Config.Appearance.RecentAccentColors, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                SelectedColor="{ReflectionBinding Config.Appearance.AccentColor, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>

        </controls:SettingsExpandControl>

        <!-- INTERFACE / PANELS -->

        <controls:SettingsExpandControl
            Icon="PanelsTopLeft"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_KEYBOARD_TITLE_INTERFACE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_AUTOHIDE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="4">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_PLAYERCONTROL_AUTOHIDE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="PanelBottom"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_PLAYERCONTROL_AUTOHIDE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Appearance.AutoHidePlayerControl, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INFOBAR_AUTOHIDE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="PanelTop"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INFOBAR_AUTOHIDE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Appearance.AutoHideInfoBarControl, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INFO_BAR_DISPLAY_MODE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="PanelTopOpen"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INFO_BAR_DISPLAY_MODE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding InfoBarDisplayModes, ElementName=Root}"
                        SelectedItem="{ReflectionBinding Config.Appearance.InfoBarDisplayMode, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource InfoBarDisplayModeToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INFO_BAR_DISPLAY_DURATION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ClockFading"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INFO_BAR_DISPLAY_DURATION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static viewModelConfig:AppearanceConfig.INFO_BAR_DISPLAY_DURATION_INCREMENT}"
                        Maximum="{x:Static viewModelConfig:AppearanceConfig.INFO_BAR_DISPLAY_DURATION_MAXIMUM}"
                        Minimum="{x:Static viewModelConfig:AppearanceConfig.INFO_BAR_DISPLAY_DURATION_MINIMUM}"
                        Suffix=" s"
                        Value="{ReflectionBinding Config.Appearance.InfoBarDisplayDuration, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_MENU_AUTOHIDE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Grip"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_MENU_AUTOHIDE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Appearance.AutoHideHamburgerMenu, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>

        </controls:SettingsExpandControl>

        <!-- WINDOW -->

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_WINDOW_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="AppWindow"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_WINDOW_OPACITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="4">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_WINDOW_BACKGROUND_MODE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="PanelsTopLeft"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_WINDOW_BACKGROUND_MODE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding WindowBackgroundModes, ElementName=Root}"
                        SelectedItem="{ReflectionBinding Config.Appearance.WindowBackgroundMode, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource WindowBackgroundModeToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>

                <controls:ColorPaletteControl
                    IsVisible="{ReflectionBinding Config.Appearance.IsSolidColorWindowBackground, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Margin="0,4"
                    RecentAccentColors="{ReflectionBinding Config.Appearance.RecentAccentColors, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    SelectedColor="{ReflectionBinding Config.Appearance.WindowBackgroundColor, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_TITLE_BACKGROUND_COLOR], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <controls:ImageSelectorControl
                    x:Name="BackgroundImageSelector"
                    AddImageRequested="BackgroundImageSelector_AddImageRequested"
                    CustomImages="{ReflectionBinding Config.Appearance.WindowBackgroundImages, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    ImageRemoved="BackgroundImageSelector_ImageRemoved"
                    IsVisible="{ReflectionBinding Config.Appearance.IsImageWindowBackground, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Margin="0,4"
                    SelectedImage="{ReflectionBinding Config.Appearance.WindowBackgroundImagePath, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_IMAGE_FILL_MODE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Scaling"
                    IsVisible="{ReflectionBinding Config.Appearance.IsImageWindowBackground, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_IMAGE_FILL_MODE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding ImageFillModes, ElementName=Root}"
                        SelectedItem="{ReflectionBinding Config.Appearance.ImageFillMode, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ImageFillModeToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>
            </StackPanel>

        </controls:SettingsExpandControl>

        <!-- TRANSPARENCY -->

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Layers2"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_TITLE_TRANSPARENCY], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="4">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_INTERFACE_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="PanelsTopLeft"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_KEYBOARD_TITLE_INTERFACE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <Grid ColumnDefinitions="48,180" ColumnSpacing="8">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Text="{ReflectionBinding Config.Appearance.InterfaceOpacity, Source={x:Static contexts:ApplicationContext.Instance}, Converter={StaticResource OpacityToPercentageConverter}, Mode=OneWay}"
                            VerticalAlignment="Center"/>

                        <Slider
                            Grid.Column="1"
                            Maximum="{x:Static viewModelConfig:AppearanceConfig.OPACITY_MAXIMUM}"
                            Minimum="{x:Static viewModelConfig:AppearanceConfig.OPACITY_MINIMUM}"
                            SmallChange="{x:Static viewModelConfig:AppearanceConfig.OPACITY_SMALL_CHANGE}"
                            Theme="{StaticResource SliderTheme}"
                            Value="{ReflectionBinding Config.Appearance.InterfaceOpacity, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                    </Grid>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_WINDOW_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="AppWindow"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_WINDOW_OPACITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <Grid ColumnDefinitions="48,180" ColumnSpacing="8">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Text="{ReflectionBinding Config.Appearance.WindowOpacity, Source={x:Static contexts:ApplicationContext.Instance}, Converter={StaticResource OpacityToPercentageConverter}, Mode=OneWay}"
                            VerticalAlignment="Center"/>

                        <Slider
                            Grid.Column="1"
                            Maximum="{x:Static viewModelConfig:AppearanceConfig.OPACITY_MAXIMUM}"
                            Minimum="{x:Static viewModelConfig:AppearanceConfig.OPACITY_MINIMUM}"
                            SmallChange="{x:Static viewModelConfig:AppearanceConfig.OPACITY_SMALL_CHANGE}"
                            Theme="{StaticResource SliderTheme}"
                            Value="{ReflectionBinding Config.Appearance.WindowOpacity, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                    </Grid>
                </controls:SettingsControl>
            </StackPanel>

        </controls:SettingsExpandControl>
        
    </StackPanel>
</UserControl>
