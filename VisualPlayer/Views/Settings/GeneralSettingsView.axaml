<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:local="using:VisualPlayer.Views.Settings"
    xmlns:localization="using:VisualPlayer.Models.Localization"
    xmlns:viewModels="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Views.Settings.GeneralSettingsView"
    x:DataType="local:GeneralSettingsView"
    x:Name="Root">

    <UserControl.Resources>
        <ControlTheme x:Key="LibraryFoldersListBoxItemTheme" BasedOn="{StaticResource ListBoxItemTheme}" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8"/>
        </ControlTheme>

        <ControlTheme x:Key="LibraryFoldersListBoxTheme" BasedOn="{StaticResource ListBoxTheme}" TargetType="ListBox">
            <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="ItemContainerTheme" Value="{StaticResource LibraryFoldersListBoxItemTheme}"/>
        </ControlTheme>

        <DataTemplate
            x:Key="LibraryFolderDataTemplate"
            x:DataType="viewModels:LibraryFolderConfig">

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">

                <LucideIcon
                    Kind="{Binding IncludeSubdirectories, Converter={x:Static local:GeneralSettingsView.FolderIconConverter}}"
                    Size="22"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"/>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="{Binding Path}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <components:ButtonWithIcon
                    Click="FolderMoreButton_Click"
                    Grid.Column="2"
                    Height="36"
                    Kind="Ellipsis"
                    Theme="{StaticResource AccentButtonWithIconTheme}"
                    Width="36">

                    <components:ButtonWithIcon.ContextMenu>
                        <ContextMenu
                            Theme="{StaticResource ContextMenuTheme}">

                            <MenuItem
                                Click="IncludeSubdirectoriesMenuItem_Click"
                                Header="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_ITEM_INCLUDE_SUBDIRECTORIES], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                IsChecked="{Binding IncludeSubdirectories, Mode=OneWay}"
                                ToggleType="CheckBox"/>

                            <MenuItem
                                Click="RefreshFolderMenuItem_Click"
                                Header="{ReflectionBinding Translations[COMMON_BUTTON_REFRESH], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                                <MenuItem.Icon>
                                    <LucideIcon
                                        Kind="RefreshCw"
                                        Size="16"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <MenuItem
                                Click="RemoveFolderMenuItem_Click"
                                Header="{ReflectionBinding Translations[COMMON_BUTTON_DELETE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                                <MenuItem.Icon>
                                    <LucideIcon
                                        Kind="Trash"
                                        Size="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </components:ButtonWithIcon.ContextMenu>
                </components:ButtonWithIcon>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- VIEW -->

    <StackPanel
        Spacing="8">

        <!-- HEADER -->
        <Grid
            ColumnDefinitions="*,Auto">

            <StackPanel
                Spacing="4">

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_NAV_GENERAL], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                IsEnabled="False"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>

        <!-- SETTINGS -->

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_LANGUAGE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Languages"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_TITLE_LANGUAGE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{ReflectionBinding Translations.AvailableLanguages, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                MinWidth="180"
                SelectedItem="{ReflectionBinding Translations.SelectedLanguage, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="localization:LanguageDefinition">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_LIBRARY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Library"
            IsExpanded="False"
            Title="{ReflectionBinding Translations[MENU_LIBRARY], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel
                Spacing="8">
                
                <ListBox
                    ItemTemplate="{StaticResource LibraryFolderDataTemplate}"
                    ItemsSource="{ReflectionBinding Config.Library.Folders, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Theme="{StaticResource LibraryFoldersListBoxTheme}"/>

                <Grid>
                    <components:ButtonWithIcon
                        Click="AddFolderButton_Click"
                        Content="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_BUTTON_ADD_CATALOG], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        HorizontalAlignment="Right"
                        Kind="FolderPlus"
                        Theme="{StaticResource AccentButtonWithIconTheme}"/>
                </Grid>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_LIBRARY_REFRESH_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="RefreshCw"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_TITLE_REFRESH_LIBRARY], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:ButtonWithIcon
                        Click="RefreshLibraryButton_Click"
                        Content="{ReflectionBinding Translations[COMMON_BUTTON_REFRESH], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        Kind="RefreshCw"
                        Theme="{StaticResource AccentButtonWithIconTheme}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_SHOW_ARTIST_ALBUMS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="DiscAlbum"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_SHOW_ARTIST_ALBUMS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Library.ShowArtistAlbums, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>
    </StackPanel>
</UserControl>
