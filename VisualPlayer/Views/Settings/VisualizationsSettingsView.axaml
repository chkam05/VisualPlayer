<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:config="using:VisualPlayer.Visualizations.Config.Base"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:local="using:VisualPlayer.Views.Settings"
    x:Class="VisualPlayer.Views.Settings.VisualizationsSettingsView"
    x:DataType="local:VisualizationsSettingsView"
    x:Name="Root">

    <UserControl.Resources>
        <converters:VisualizationGlobalOptionToTitleConverter x:Key="OptionToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[MENU_VISUALIZATIONS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Click="ResetButton_Click"
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>

        <!-- FREQUENCY RANGE -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FREQUENCY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="AudioLines"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_TITLE_FREQUENCY_RANGE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="4">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINIMUM_FREQUENCY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ArrowDownToLine"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINIMUM_FREQUENCY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:VisualizationGlobalConfig.MINIMUM_FREQUENCY_INCREMENT}"
                        Maximum="{x:Static config:VisualizationGlobalConfig.MINIMUM_FREQUENCY_MAXIMUM}"
                        Minimum="{x:Static config:VisualizationGlobalConfig.MINIMUM_FREQUENCY_MINIMUM}"
                        Suffix=" Hz"
                        Value="{ReflectionBinding VisualizationConfig.Global.MinimumFrequency, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MAXIMUM_FREQUENCY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ArrowUpToLine"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MAXIMUM_FREQUENCY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:VisualizationGlobalConfig.MAXIMUM_FREQUENCY_INCREMENT}"
                        Maximum="{x:Static config:VisualizationGlobalConfig.MAXIMUM_FREQUENCY_MAXIMUM}"
                        Minimum="{x:Static config:VisualizationGlobalConfig.MAXIMUM_FREQUENCY_MINIMUM}"
                        Suffix=" Hz"
                        Value="{ReflectionBinding VisualizationConfig.Global.MaximumFrequency, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_SCALING_STRATEGY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ChartNoAxesColumnIncreasing"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_SCALING_STRATEGY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding ScalingStrategies, ElementName=Root}"
                        SelectedItem="{ReflectionBinding VisualizationConfig.Global.ScalingStrategy, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Converter={StaticResource OptionToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <!-- FFT ANALYSIS -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FFT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="AudioWaveform"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_TITLE_FFT_ANALYSIS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="4">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FFT_SIZE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Binary"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FFT_SIZE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding FftSizes, ElementName=Root}"
                        SelectedItem="{ReflectionBinding VisualizationConfig.Global.FftSize, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Converter={StaticResource OptionToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FFT_WINDOW_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ScanLine"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FFT_WINDOW_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding FftWindows, ElementName=Root}"
                        SelectedItem="{ReflectionBinding VisualizationConfig.Global.FftWindow, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Converter={StaticResource OptionToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_CHANNEL_MODE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="AudioWaveform"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_CHANNEL_MODE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding ChannelModes, ElementName=Root}"
                        SelectedItem="{ReflectionBinding VisualizationConfig.Global.ChannelMode, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Converter={StaticResource OptionToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <!-- SIGNAL DYNAMICS -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_DYNAMICS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Gauge"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_TITLE_SIGNAL_DYNAMICS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="4">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINIMUM_DECIBELS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Volume1"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINIMUM_DECIBELS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static config:VisualizationGlobalConfig.MINIMUM_DECIBELS_MAXIMUM}"
                        Minimum="{x:Static config:VisualizationGlobalConfig.MINIMUM_DECIBELS_MINIMUM}"
                        Suffix=" dB"
                        Value="{ReflectionBinding VisualizationConfig.Global.MinimumDecibels, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MAXIMUM_DECIBELS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Volume2"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MAXIMUM_DECIBELS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Maximum="{x:Static config:VisualizationGlobalConfig.MAXIMUM_DECIBELS_MAXIMUM}"
                        Minimum="{x:Static config:VisualizationGlobalConfig.MAXIMUM_DECIBELS_MINIMUM}"
                        Suffix=" dB"
                        Value="{ReflectionBinding VisualizationConfig.Global.MaximumDecibels, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_ATTACK_TIME_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="TrendingUp"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_ATTACK_TIME_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:VisualizationGlobalConfig.ATTACK_TIME_INCREMENT}"
                        Maximum="{x:Static config:VisualizationGlobalConfig.ATTACK_TIME_MAXIMUM}"
                        Minimum="{x:Static config:VisualizationGlobalConfig.ATTACK_TIME_MINIMUM}"
                        Suffix=" ms"
                        Value="{ReflectionBinding VisualizationConfig.Global.AttackTime, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_RELEASE_TIME_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="TrendingDown"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_RELEASE_TIME_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:VisualizationGlobalConfig.RELEASE_TIME_INCREMENT}"
                        Maximum="{x:Static config:VisualizationGlobalConfig.RELEASE_TIME_MAXIMUM}"
                        Minimum="{x:Static config:VisualizationGlobalConfig.RELEASE_TIME_MINIMUM}"
                        Suffix=" ms"
                        Value="{ReflectionBinding VisualizationConfig.Global.ReleaseTime, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <!-- RENDERING -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FRAME_RATE_LIMIT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="MonitorUp"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_FRAME_RATE_LIMIT_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static config:VisualizationGlobalConfig.FRAME_RATE_INCREMENT}"
                Maximum="{x:Static config:VisualizationGlobalConfig.FRAME_RATE_MAXIMUM}"
                Minimum="{x:Static config:VisualizationGlobalConfig.FRAME_RATE_MINIMUM}"
                Suffix=" FPS"
                Value="{ReflectionBinding VisualizationConfig.Global.FrameRateLimit, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>
    </StackPanel>
</UserControl>
