<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:local="using:VisualPlayer.Views.Settings"
    xmlns:viewModels="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Views.Settings.MiniPlayerSettingsView"
    x:DataType="local:MiniPlayerSettingsView"
    x:Name="Root">

    <UserControl.Resources>
        <converters:OpacityToPercentageConverter x:Key="OpacityToPercentageConverter"/>
        <converters:VisualizationGlobalOptionToTitleConverter x:Key="VisualizationTypeToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel
        Spacing="8">

        <!-- HEADER -->
        <Grid
            ColumnDefinitions="*,Auto">

            <StackPanel
                Spacing="4">

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_NAV_MINI_PLAYER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_MINI_PLAYER_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                IsEnabled="False"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>

        <!-- STAY ON TOP -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_MINI_STAY_ON_TOP_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Pin"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_GENERAL_MINI_STAY_ON_TOP_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.MiniPlayer.StayOnTop, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- SHOW COVER -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_MINI_PLAYER_SHOW_COVER_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Image"
            Title="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_SHOW_COVER], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.MiniPlayer.ShowCover, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- SHOW VISUALIZATION -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINI_SHOW_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="AudioLines"
            Title="{ReflectionBinding Translations[PLAYER_MINI_CONTEXT_SHOW_VISUALIZATION], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.MiniPlayer.ShowVisualization, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- VISUALIZATION TYPE -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINI_TYPE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ChartNoAxesColumn"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_VISUALIZATIONS_MINI_TYPE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding VisualizationTypes, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.MiniPlayer.VisualizationType, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource VisualizationTypeToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- OPACITY -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_APPEARANCE_MINI_PLAYER_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Blend"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_MINI_PLAYER_OPACITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <Grid ColumnDefinitions="48,180" ColumnSpacing="8">
                <TextBlock
                    HorizontalAlignment="Right"
                    Text="{ReflectionBinding Config.MiniPlayer.Opacity, Source={x:Static contexts:ApplicationContext.Instance}, Converter={StaticResource OpacityToPercentageConverter}, Mode=OneWay}"
                    VerticalAlignment="Center"/>

                <Slider
                    Grid.Column="1"
                    Maximum="{x:Static viewModels:MiniPlayerConfig.OPACITY_MAXIMUM}"
                    Minimum="{x:Static viewModels:MiniPlayerConfig.OPACITY_MINIMUM}"
                    SmallChange="{x:Static viewModels:MiniPlayerConfig.OPACITY_SMALL_CHANGE}"
                    Theme="{StaticResource SliderTheme}"
                    Value="{ReflectionBinding Config.MiniPlayer.Opacity, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
            </Grid>
        </controls:SettingsControl>
    </StackPanel>
</UserControl>
