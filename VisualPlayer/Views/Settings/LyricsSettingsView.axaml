<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:local="using:VisualPlayer.Views.Settings"
    xmlns:config="using:VisualPlayer.ViewModels.Config"
    x:Class="VisualPlayer.Views.Settings.LyricsSettingsView"
    x:DataType="local:LyricsSettingsView"
    x:Name="Root">

    <UserControl.Resources>
        <converters:LyricsTypeToTitleConverter x:Key="LyricsTypeToTitleConverter"/>
        <converters:OpacityToPercentageConverter x:Key="OpacityToPercentageConverter"/>

        <!-- LYRICS PREFFERED TYPE ITEM -->
        <DataTemplate x:Key="LyricsTypeDataTemplate">
            <TextBlock
                Text="{Binding Converter={StaticResource LyricsTypeToTitleConverter}}"/>
        </DataTemplate>
    </UserControl.Resources>
    
    <!-- MAIN VIEW -->

    <StackPanel
        Spacing="8">

        <!-- HEADER -->
        <Grid
            ColumnDefinitions="*,Auto">

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ReflectionBinding Translations[MENU_LYRICS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

                <TextBlock
                    Opacity="0.6"
                    Text="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SUBTITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </StackPanel>

            <components:ButtonWithIcon
                Click="ResetButton_Click"
                Content="{ReflectionBinding Translations[COMMON_BUTTON_RESET], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Grid.Column="1"
                Kind="RotateCcw"
                Theme="{StaticResource InternalView.ResetButtonWithIconTheme}"/>
        </Grid>

        <!-- OPTIONS -->
        
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_DISPLAY_LYRICS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Type"
            Title="{ReflectionBinding Translations[VIEW_LYRICS_TEXT_DISPLAY_LYRICS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Lyrics.DisplayLyrics, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_FONT_SIZE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="TextCursorInput"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_TITLE_LYRICS_SIZE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="8">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_CURRENT_LINE_FONT_SIZE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Type"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_CURRENT_LINE_FONT_SIZE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:LyricsConfig.FONT_SIZE_INCREMENT}"
                        Maximum="{x:Static config:LyricsConfig.FONT_SIZE_MAXIMUM}"
                        Minimum="{x:Static config:LyricsConfig.FONT_SIZE_MINIMUM}"
                        Suffix=" px"
                        Value="{ReflectionBinding Config.Lyrics.CurrentLineFontSize, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SURROUNDING_LINE_FONT_SIZE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="BetweenHorizontalStart"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SURROUNDING_LINE_FONT_SIZE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:LyricsConfig.FONT_SIZE_INCREMENT}"
                        Maximum="{x:Static config:LyricsConfig.FONT_SIZE_MAXIMUM}"
                        Minimum="{x:Static config:LyricsConfig.FONT_SIZE_MINIMUM}"
                        Suffix=" px"
                        Value="{ReflectionBinding Config.Lyrics.SurroundingLineFontSize, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_PLAIN_TEXT_FONT_SIZE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ScrollText"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_PLAIN_TEXT_FONT_SIZE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:LyricsConfig.FONT_SIZE_INCREMENT}"
                        Maximum="{x:Static config:LyricsConfig.FONT_SIZE_MAXIMUM}"
                        Minimum="{x:Static config:LyricsConfig.FONT_SIZE_MINIMUM}"
                        Suffix=" px"
                        Value="{ReflectionBinding Config.Lyrics.PlainTextFontSize, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_BACKGROUND_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Layers2"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_BACKGROUND_OPACITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <Grid
                ColumnDefinitions="48,180"
                ColumnSpacing="8">

                <TextBlock
                    HorizontalAlignment="Right"
                    Text="{ReflectionBinding Config.Lyrics.BackgroundOpacity, Source={x:Static contexts:ApplicationContext.Instance}, Converter={StaticResource OpacityToPercentageConverter}, Mode=OneWay}"
                    VerticalAlignment="Center"/>

                <Slider
                    Grid.Column="1"
                    Maximum="{x:Static config:LyricsConfig.BACKGROUND_OPACITY_MAXIMUM}"
                    Minimum="{x:Static config:LyricsConfig.BACKGROUND_OPACITY_MINIMUM}"
                    SmallChange="{x:Static config:LyricsConfig.BACKGROUND_OPACITY_INCREMENT}"
                    Theme="{StaticResource SliderTheme}"
                    Value="{ReflectionBinding Config.Lyrics.BackgroundOpacity, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
            </Grid>
        </controls:SettingsControl>

        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_EDITOR_INTERVAL_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ClockArrowRight"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_TITLE_EDITOR_INTERVALS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel Spacing="8">
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SEEK_SHORT_INTERVAL_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="StepForward"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SEEK_SHORT_INTERVAL_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:LyricsConfig.SEEK_INTERVAL_INCREMENT}"
                        Maximum="{x:Static config:LyricsConfig.SEEK_INTERVAL_MAXIMUM}"
                        Minimum="{x:Static config:LyricsConfig.SEEK_INTERVAL_MINIMUM}"
                        Suffix=" s"
                        Value="{ReflectionBinding Config.Lyrics.SeekShortInterval, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SEEK_MEDIUM_INTERVAL_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="FastForward"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SEEK_MEDIUM_INTERVAL_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:LyricsConfig.SEEK_INTERVAL_INCREMENT}"
                        Maximum="{x:Static config:LyricsConfig.SEEK_INTERVAL_MAXIMUM}"
                        Minimum="{x:Static config:LyricsConfig.SEEK_INTERVAL_MINIMUM}"
                        Suffix=" s"
                        Value="{ReflectionBinding Config.Lyrics.SeekMediumInterval, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SEEK_LONG_INTERVAL_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="SkipForward"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_SEEK_LONG_INTERVAL_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static config:LyricsConfig.SEEK_INTERVAL_INCREMENT}"
                        Maximum="{x:Static config:LyricsConfig.SEEK_INTERVAL_MAXIMUM}"
                        Minimum="{x:Static config:LyricsConfig.SEEK_INTERVAL_MINIMUM}"
                        Suffix=" s"
                        Value="{ReflectionBinding Config.Lyrics.SeekLongInterval, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_USE_EMBEDDED_LYRICS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="FileMusic"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_USE_EMBEDDED_LYRICS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Lyrics.UseEmbeddedLyrics, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_AUTO_IMPORT_EMBEDDED_LYRICS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="FileDown"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_AUTO_IMPORT_EMBEDDED_LYRICS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Lyrics.AutoImportEmbeddedLyrics, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_AUTO_DOWNLOAD_LYRICS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="HardDriveDownload"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_AUTO_DOWNLOAD_LYRICS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.Lyrics.AutoDownloadLyrics, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_PREFERRED_TYPE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ScrollText"
            Title="{ReflectionBinding Translations[VIEW_SETTINGS_LYRICS_PREFERRED_TYPE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemTemplate="{StaticResource LyricsTypeDataTemplate}"
                ItemsSource="{Binding LyricsTypes, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.Lyrics.PreferredType, Source={x:Static contexts:ApplicationContext.Instance}, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}"/>
        </controls:SettingsControl>
    </StackPanel>
</UserControl>
