<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:dialogs="using:VisualPlayer.Views.Dialogs">

    <ControlTemplate x:Key="InternalMessageDialogTemplate" x:DataType="dialogs:InternalMessageDialog" TargetType="dialogs:InternalMessageDialog">
        <Border
            Background="{ReflectionBinding Config.Appearance.ThemeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            BorderBrush="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="10"
            MaxWidth="560"
            MinWidth="320">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- TITLE BAR -->
                <Border
                    Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Padding="16,12">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10">

                        <LucideIcon
                            Kind="{TemplateBinding Icon}"
                            Size="22"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Grid.Column="1"
                            Text="{TemplateBinding Title}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"/>

                        <components:ButtonWithIcon
                            x:Name="PART_CloseButton"
                            Grid.Column="2"
                            IsVisible="{TemplateBinding EnableCloseButton}"
                            Kind="X"
                            Theme="{StaticResource InternalMessage.ButtonWithIconTheme}"
                            ToolTip.Tip="{ReflectionBinding Translations[DIALOG_BUTTON_CLOSE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
                    </Grid>
                </Border>

                <!-- CONTENT -->
                <ContentPresenter
                    Grid.Row="1"
                    Content="{TemplateBinding Content}"
                    Margin="24"
                    TextBlock.TextWrapping="Wrap"/>

                <!-- FOOTER -->
                <Border
                    Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Grid.Row="2"
                    Padding="12">

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">

                        <Button
                            x:Name="PART_OkButton"
                            Content="{ReflectionBinding Translations[DIALOG_BUTTON_OK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="False"
                            Theme="{StaticResource InternalMessage.ButtonTheme}"/>

                        <Button
                            x:Name="PART_CancelButton"
                            Content="{ReflectionBinding Translations[DIALOG_INTERNAL_MESSAGE_BUTTON_CANCEL], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="False"
                            Theme="{StaticResource InternalMessage.ButtonTheme}"/>

                        <Button
                            x:Name="PART_YesButton"
                            Content="{ReflectionBinding Translations[DIALOG_INTERNAL_MESSAGE_DIALOG_BUTTON_YES], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="False"
                            Theme="{StaticResource InternalMessage.ButtonTheme}"/>

                        <Button
                            x:Name="PART_NoButton"
                            Content="{ReflectionBinding Translations[DIALOG_INTERNAL_MESSAGE_DIALOG_BUTTON_NO], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="False"
                            Theme="{StaticResource InternalMessage.ButtonTheme}"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type dialogs:InternalMessageDialog}" TargetType="dialogs:InternalMessageDialog">

        <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource InternalMessageDialogTemplate}"/>

        <Style Selector="^[Buttons=Ok] /template/ Button#PART_OkButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=OkCancel] /template/ Button#PART_CancelButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=OkCancel] /template/ Button#PART_OkButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=YesNo] /template/ Button#PART_NoButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=YesNo] /template/ Button#PART_YesButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=YesNoCancel] /template/ Button#PART_CancelButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=YesNoCancel] /template/ Button#PART_NoButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[Buttons=YesNoCancel] /template/ Button#PART_YesButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
