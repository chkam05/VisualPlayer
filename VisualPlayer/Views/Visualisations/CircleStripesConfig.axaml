<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:common="using:VisualPlayer.Views.Visualisations.Common"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:profile="using:VisualPlayer.Visualizations.Config.Base"
    x:Class="VisualPlayer.Views.Visualisations.CircleStripesConfig"
    x:DataType="profile:VisualisationProfile"
    x:Name="Root">

    <UserControl.Resources>
        <converters:BeamEffectToTitleConverter x:Key="BeamEffectToTitleConverter"/>
        <converters:RadialVisualizationDirectionToTitleConverter x:Key="RadialDirectionToTitleConverter"/>
        <converters:RotationDirectionToTitleConverter x:Key="RotationDirectionToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="8">

        <!-- Color -->
        <common:VisualisationColorConfig/>

        <!-- Number of peaks -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_STRIPES_COUNT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ChartNoAxesColumn"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_NUM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static profile:VisualizationBaseConfig.BARS_COUNT_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.BARS_COUNT_MINIMUM}"
                Value="{ReflectionBinding Config.StripesCount, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Direction -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_DIRECTION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ArrowUpDown"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_DIRECTION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding Directions, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.Direction, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Converter={StaticResource RadialDirectionToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- Thickness -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_LINE_THICKNESS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Minus"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_LINE_THICKNESS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static profile:VisualizationBaseConfig.LINE_THICKNESS_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.LINE_THICKNESS_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Config.LineThickness, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Radius -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_INNER_RADIUS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Circle"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_INNER_RADIUS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static profile:VisualizationBaseConfig.INNER_RADIUS_INCREMENT}"
                Maximum="{x:Static profile:VisualizationBaseConfig.INNER_RADIUS_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.INNER_RADIUS_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Config.InnerRadius, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Falling speed -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_DESCENT_RATE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ClockFading"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_DESCENT_RATE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static profile:VisualizationBaseConfig.DESCENT_RATE_INCREMENT}"
                Maximum="{x:Static profile:VisualizationBaseConfig.DESCENT_RATE_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.DESCENT_RATE_MINIMUM}"
                Suffix=" px/s"
                Value="{ReflectionBinding Config.DescentRate, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Effects -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_BEAM_EFFECT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Sparkles"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_LINE_EFFECT_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding BeamEffects, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.BeamEffect, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Converter={StaticResource BeamEffectToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- Transformation -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_TRANSFORM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Move3d"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_TRANSFORM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel
                Spacing="8">

                <!-- Mirror -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_MIRROR_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ArrowLeftRight"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_MIRROR_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Mirror, Mode=TwoWay}"/>
                </controls:SettingsControl>
                
                <!-- Move X -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_CENTER_OFFSET_X_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="MoveHorizontal"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_CENTER_OFFSET_X_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static profile:VisualizationBaseConfig.CENTER_OFFSET_INCREMENT}"
                        Maximum="{x:Static profile:VisualizationBaseConfig.CENTER_OFFSET_MAXIMUM}"
                        Minimum="{x:Static profile:VisualizationBaseConfig.CENTER_OFFSET_MINIMUM}"
                        Suffix=" px"
                        Value="{ReflectionBinding Config.CenterOffsetX, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <!-- Move Y -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_CENTER_OFFSET_Y_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="MoveVertical"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_CENTER_OFFSET_Y_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static profile:VisualizationBaseConfig.CENTER_OFFSET_INCREMENT}"
                        Maximum="{x:Static profile:VisualizationBaseConfig.CENTER_OFFSET_MAXIMUM}"
                        Minimum="{x:Static profile:VisualizationBaseConfig.CENTER_OFFSET_MINIMUM}"
                        Suffix=" px"
                        Value="{ReflectionBinding Config.CenterOffsetY, Mode=TwoWay}"/>
                </controls:SettingsControl>

            </StackPanel>
        </controls:SettingsExpandControl>

        <!-- Angle -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="RotateCw"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static profile:VisualizationBaseConfig.ROTATION_INCREMENT}"
                IsEnabled="{ReflectionBinding Config.CanSetRotation}"
                Maximum="{x:Static profile:VisualizationBaseConfig.ROTATION_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.ROTATION_MINIMUM}"
                Suffix="°"
                Value="{ReflectionBinding Config.Rotation, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Animation -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_ANIMATION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ImagePlay"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_ANIMATION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel
                Spacing="8">

                <!-- Animation toggle -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_ENABLED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ToggleRight"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_ENABLED_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.RotationAnimationEnabled, Mode=TwoWay}"/>
                </controls:SettingsControl>
                
                <!-- Animation directions -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_DIRECTION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="RotateCw"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_DIRECTION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding RotationDirections, ElementName=Root}"
                        SelectedItem="{ReflectionBinding Config.RotationDirection, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Converter={StaticResource RotationDirectionToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>

                <!-- Animation speed -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_SPEED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="Gauge"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_CIRCLE_STRIPES_ROTATION_SPEED_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static profile:VisualizationBaseConfig.ROTATION_SPEED_INCREMENT}"
                        Maximum="{x:Static profile:VisualizationBaseConfig.ROTATION_SPEED_MAXIMUM}"
                        Minimum="{x:Static profile:VisualizationBaseConfig.ROTATION_SPEED_MINIMUM}"
                        Suffix=" °/s"
                        Value="{ReflectionBinding Config.RotationSpeed, Mode=TwoWay}"/>
                </controls:SettingsControl>
            </StackPanel>
        </controls:SettingsExpandControl>
    </StackPanel>
</UserControl>
