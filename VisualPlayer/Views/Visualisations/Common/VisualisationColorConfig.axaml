<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:visualizationConfig="using:VisualPlayer.Visualizations.Config.Base"
    x:Class="VisualPlayer.Views.Visualisations.Common.VisualisationColorConfig"
    x:DataType="visualizationConfig:VisualisationProfile"
    x:Name="Root">

    <UserControl.Resources>
        <converters:GradientTypeToTitleConverter x:Key="GradientTypeToTitleConverter"/>
        <converters:VisualizationColorModeToTitleConverter x:Key="VisualizationColorModeToTitleConverter"/>
    </UserControl.Resources>

    <components:SettingsExpandControl
        Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
        Icon="Palette"
        Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_COLOR], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

        <StackPanel
            Spacing="8">

            <!-- Color type -->
            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_MODE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="Paintbrush"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_COLOR_TYPE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <ComboBox
                    ItemsSource="{Binding ColorModes, ElementName=Root}"
                    SelectedItem="{ReflectionBinding Color.Mode, Mode=TwoWay}"
                    Theme="{StaticResource ComboBoxTheme}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource VisualizationColorModeToTitleConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </components:SettingsControl>

            <!-- Gradient -->
            <controls:GradientControl
                x:Name="GradientEditor"
                Gradient="{ReflectionBinding Color.Gradient, Mode=TwoWay}"
                IsVisible="{ReflectionBinding Color.IsGradient}"/>

            <!-- Rainbow type -->
            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_GRADIENT_TYPE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="Blend"
                IsVisible="{ReflectionBinding Color.IsRainbow}"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_TYPE_OF_RAINBOW], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <ComboBox
                    ItemsSource="{Binding GradientTypes, ElementName=Root}"
                    SelectedItem="{ReflectionBinding Color.RainbowGradientType, Mode=TwoWay}"
                    Theme="{StaticResource ComboBoxTheme}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource GradientTypeToTitleConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </components:SettingsControl>

            <!-- Rainbow angle -->
            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_ANGLE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="RotateCw"
                IsVisible="{ReflectionBinding Color.IsRainbow}"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_RAINBOW_ANGLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <components:NumericUpDown
                    Maximum="{x:Static visualizationConfig:GradientDefinition.ANGLE_MAXIMUM}"
                    Minimum="{x:Static visualizationConfig:GradientDefinition.ANGLE_MINIMUM}"
                    Suffix="°"
                    Value="{ReflectionBinding Color.RainbowAngle, Mode=TwoWay}"/>
            </components:SettingsControl>

            <!-- Solid color palette -->
            <controls:ColorPaletteControl
                IsVisible="{ReflectionBinding Color.IsSolid}"
                RecentAccentColors="{ReflectionBinding Color.RecentColors}"
                SelectedColor="{ReflectionBinding Color.SolidColor, Mode=TwoWay}"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_VISUALIZATION_COLOR], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

            <!-- Gradient color palette -->
            <controls:ColorPaletteControl
                IsVisible="{ReflectionBinding Color.IsGradient}"
                RecentAccentColors="{ReflectionBinding Color.RecentColors}"
                SelectedColor="{Binding SelectedPoint.Color, ElementName=GradientEditor, Mode=TwoWay}"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_COLOR_OF_THE_SELECTED_POINT], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>

            <!-- Animation enable -->
            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_ANIMATION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="AudioWaveform"
                IsVisible="{ReflectionBinding Color.IsAnimationAvailable}"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_GRADIENT_ANIMATION], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <components:Switch IsChecked="{ReflectionBinding Color.AnimateGradient, Mode=TwoWay}"/>
            </components:SettingsControl>

            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_ANIMATION_SPEED_MINIMUM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="ClockArrowUp"
                IsVisible="{ReflectionBinding Color.IsAnimationEnabled}"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_ANIMATION_SPEED_MINIMUM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <components:NumericUpDown
                    Increment="{x:Static visualizationConfig:VisualizationColorConfig.ANIMATION_SPEED_INCREMENT}"
                    Maximum="{x:Static visualizationConfig:VisualizationColorConfig.ANIMATION_SPEED_MAXIMUM}"
                    Minimum="{x:Static visualizationConfig:VisualizationColorConfig.ANIMATION_SPEED_MINIMUM}"
                    Suffix=" px/s"
                    Value="{ReflectionBinding Color.VerticalAnimationSpeed, Mode=TwoWay}"/>
            </components:SettingsControl>

            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_HORIZONTAL_SPEED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="ClockArrowRight"
                IsVisible="{ReflectionBinding Color.IsAnimationEnabled}"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_TITLE_HORIZONTAL_SPEED], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <components:NumericUpDown
                    Increment="{x:Static visualizationConfig:VisualizationColorConfig.ANIMATION_SPEED_INCREMENT}"
                    Maximum="{x:Static visualizationConfig:VisualizationColorConfig.ANIMATION_SPEED_MAXIMUM}"
                    Minimum="{x:Static visualizationConfig:VisualizationColorConfig.ANIMATION_SPEED_MINIMUM}"
                    Suffix=" px/s"
                    Value="{ReflectionBinding Color.HorizontalAnimationSpeed, Mode=TwoWay}"/>
            </components:SettingsControl>

            <components:SettingsControl
                Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_STRETCH_MINIMUM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                Icon="Expand"
                IsVisible="{ReflectionBinding Color.IsAnimationAvailable}"
                Classes="darker"
                Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_COLOR_STRETCH_MINIMUM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                <components:NumericUpDown
                    Increment="{x:Static visualizationConfig:VisualizationColorConfig.STRETCH_INCREMENT}"
                    Maximum="{x:Static visualizationConfig:VisualizationColorConfig.STRETCH_MAXIMUM}"
                    Minimum="{x:Static visualizationConfig:VisualizationColorConfig.STRETCH_MINIMUM}"
                    Suffix="%"
                    Value="{ReflectionBinding Color.Stretch, Mode=TwoWay}"/>
            </components:SettingsControl>
        </StackPanel>
    </components:SettingsExpandControl>
</UserControl>
