<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:common="using:VisualPlayer.Views.Visualisations.Common"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:config="using:VisualPlayer.Visualizations.Config"
    xmlns:visualizationConfig="using:VisualPlayer.Visualizations.Config.Base"
    x:Class="VisualPlayer.Views.Visualisations.PeaksConfig"
    x:DataType="visualizationConfig:VisualisationProfile"
    x:Name="Root">

    <UserControl.Resources>
        <converters:VisualizationDirectionToTitleConverter x:Key="VisualizationDirectionToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel
        Orientation="Vertical"
        Spacing="8">

        <!-- Color -->
        <common:VisualisationColorConfig/>

        <!-- Number of peaks -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_NUM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ChartNoAxesColumn"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_NUM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BARS_COUNT_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BARS_COUNT_MINIMUM}"
                Value="{ReflectionBinding Config.PeaksCount, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Direction -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_DIRECTION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ArrowUpDown"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_DIRECTION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding Directions, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.Direction, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Converter={StaticResource VisualizationDirectionToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- Horizontal spacing -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_HORIZONTAL_BAR_SPACE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="BetweenVerticalStart"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_HORIZONTAL_BAR_SPACE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_SPACE_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_SPACE_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Config.HorizontalBarSpace, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Vertical spacing -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_VERTICAL_BAR_SPACE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="BetweenHorizontalStart"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_VERTICAL_BAR_SPACE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_SPACE_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_SPACE_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Config.VerticalBarSpace, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Peak height -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_BAR_HEIGHT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="MoveVertical"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_BAR_HEIGHT_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_HEIGHT_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_HEIGHT_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Config.BarHeight, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Falling speed -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_DESCENT_RATE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ClockFading"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_DESCENT_RATE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_INCREMENT}"
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_MINIMUM}"
                Suffix=" px/s"
                Value="{ReflectionBinding Config.DescentRate, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Floating peak -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_FLOATING_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="RectangleHorizontal"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_TITLE_FALLING_BLOCK], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel
                Orientation="Vertical"
                Spacing="8">

                <!-- Floating peak on/off switch -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_SHOW_FLOATING_BAR_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ToggleRight"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_SHOW_FLOATING_BAR_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.ShowFloatingBar, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <!-- Floating peak gravity -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_USE_FLOATING_BAR_GRAVITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ArrowDownFromLine"
                    IsVisible="{ReflectionBinding SupportsFloatingBarGravity}"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_USE_FLOATING_BAR_GRAVITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.UseFloatingBarGravity, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <!-- Floating peak falling speed -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_FLOATING_BAR_DESCENT_RATE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ClockFading"
                    Theme="{StaticResource SettingsControlDarkerControl}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_PEAKS_FLOATING_BAR_DESCENT_RATE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_INCREMENT}"
                        Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_MAXIMUM}"
                        Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_MINIMUM}"
                        Suffix=" px/s"
                        Value="{ReflectionBinding Config.FloatingBarDescentRate, Mode=TwoWay}"/>
                </controls:SettingsControl>

            </StackPanel>
        </controls:SettingsExpandControl>

    </StackPanel>
</UserControl>
