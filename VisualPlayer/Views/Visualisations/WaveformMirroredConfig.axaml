<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:common="using:VisualPlayer.Views.Visualisations.Common"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:config="using:VisualPlayer.Visualizations.Config"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:profile="using:VisualPlayer.Visualizations.Config.Base"
    x:Class="VisualPlayer.Views.Visualisations.WaveformMirroredConfig"
    x:DataType="profile:VisualisationProfile"
    x:Name="Root">

    <UserControl.Resources>
        <converters:BeamEffectToTitleConverter x:Key="BeamEffectToTitleConverter"/>
        <converters:OpacityToPercentageConverter x:Key="OpacityToPercentageConverter"/>
        <converters:MirroredVisualizationDirectionToTitleConverter x:Key="MirroredVisualizationDirectionToTitleConverter"/>
        <converters:WaveformTransformationToTitleConverter x:Key="WaveformTransformationToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel
        Spacing="8">

        <!-- Color -->
        <common:VisualisationColorConfig/>

        <!-- Number of peaks -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_NUM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ChartNoAxesColumn"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_NUM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static profile:VisualizationBaseConfig.BARS_COUNT_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.BARS_COUNT_MINIMUM}"
                Value="{ReflectionBinding Config.PeaksCount, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Direction -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_DIRECTION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ArrowUpDown"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_DIRECTION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding Directions, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.Direction, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Converter={StaticResource MirroredVisualizationDirectionToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- Thickness -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_LINE_THICKNESS_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Minus"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_LINE_THICKNESS_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static profile:VisualizationBaseConfig.LINE_THICKNESS_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.LINE_THICKNESS_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Config.LineThickness, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Falling speed -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_DESCENT_RATE_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="ClockFading"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_DESCENT_RATE_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static profile:VisualizationBaseConfig.DESCENT_RATE_INCREMENT}"
                Maximum="{x:Static profile:VisualizationBaseConfig.DESCENT_RATE_MAXIMUM}"
                Minimum="{x:Static profile:VisualizationBaseConfig.DESCENT_RATE_MINIMUM}"
                Suffix=" px/s"
                Value="{ReflectionBinding Config.DescentRate, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Effects -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_BEAM_EFFECT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Sparkles"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_LINE_EFFECT_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding BeamEffects, ElementName=Root}"
                SelectedItem="{ReflectionBinding Config.BeamEffect, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Converter={StaticResource BeamEffectToTitleConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- Fill -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_FILL_ENABLED_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="PaintBucket"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_FILL_ENABLED_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <components:Switch
                IsChecked="{ReflectionBinding Config.FillEnabled, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Transparency -->
        <controls:SettingsControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_OPACITY_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Blend"
            IsVisible="{ReflectionBinding Config.FillEnabled}"
            Title="{ReflectionBinding Translations[COMMON_OPACITY_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <Grid ColumnDefinitions="48,180" ColumnSpacing="8">
                <TextBlock
                    HorizontalAlignment="Right"
                    Text="{ReflectionBinding Config.Opacity, Converter={StaticResource OpacityToPercentageConverter}, Mode=OneWay}"
                    VerticalAlignment="Center"/>

                <Slider
                    Grid.Column="1"
                    Maximum="{x:Static config:WaveformMirroredVisualizationConfig.OPACITY_MAXIMUM}"
                    Minimum="{x:Static config:WaveformMirroredVisualizationConfig.OPACITY_MINIMUM}"
                    SmallChange="{x:Static config:WaveformMirroredVisualizationConfig.OPACITY_SMALL_CHANGE}"
                    Theme="{StaticResource SliderTheme}"
                    Value="{ReflectionBinding Config.Opacity, Mode=TwoWay}"/>
            </Grid>
        </controls:SettingsControl>

        <!-- Transformation -->
        <controls:SettingsExpandControl
            Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_TRANSFORM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            Icon="Move3d"
            Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_TRANSFORM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

            <StackPanel
                Spacing="8">

                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_TRANSFORMATION_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="AudioWaveform"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_TRANSFORMATION_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <ComboBox
                        ItemsSource="{Binding Transformations, ElementName=Root}"
                        SelectedItem="{ReflectionBinding Config.Transformation, Mode=TwoWay}"
                        Theme="{StaticResource ComboBoxTheme}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Converter={StaticResource WaveformTransformationToTitleConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsControl>

                <!-- Transformation shift -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_TRANSFORMATION_MINIMUM_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="MoveVertical"
                    IsVisible="{ReflectionBinding Config.IsTransformationEnabled}"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_TRANSFORMATION_MINIMUM_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:NumericUpDown
                        Increment="{x:Static profile:VisualizationBaseConfig.TRANSFORMATION_MINIMUM_INCREMENT}"
                        Maximum="{x:Static profile:VisualizationBaseConfig.TRANSFORMATION_MINIMUM_MAXIMUM}"
                        Minimum="{x:Static profile:VisualizationBaseConfig.TRANSFORMATION_MINIMUM_MINIMUM}"
                        Suffix="%"
                        Value="{ReflectionBinding Config.TransformationMinimum, Mode=TwoWay}"/>
                </controls:SettingsControl>

                <!-- Shift -->
                <controls:SettingsControl
                    Description="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_SHIFT_DESC], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Icon="ArrowLeftRight"
                    Title="{ReflectionBinding Translations[VIEW_VISUALIZATIONS_WAVEFORM_SHIFT_TITLE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}">

                    <components:Switch
                        IsChecked="{ReflectionBinding Config.Shift, Mode=TwoWay}"/>
                </controls:SettingsControl>

            </StackPanel>
        </controls:SettingsExpandControl>

    </StackPanel>
</UserControl>
