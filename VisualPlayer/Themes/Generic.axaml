<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VisualPlayer.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- BASE -->
        <ResourceInclude Source="/Themes/Base/ButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/ContextMenuTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/ContextMenuItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/ComboBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/ComboBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/ListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/ListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/SliderTheme.axaml" />
        <ResourceInclude Source="/Themes/Base/TextBox.axaml" />

        <!-- PLAYER -->
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerPositionSliderTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerMiniPositionSliderTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerVolumeSliderTheme.axaml" />

        <!-- CUSTOM COMPONENTS -->
        <ResourceInclude Source="/Themes/Components/ButtonWithIcon.axaml" />
        <ResourceInclude Source="/Themes/Components/ColorValueSlider.axaml" />
        <ResourceInclude Source="/Themes/Components/KeyBindControl.axaml" />
        <ResourceInclude Source="/Themes/Components/NumericUpDown.axaml" />
        <ResourceInclude Source="/Themes/Components/ScrollTextBlock.axaml" />
        <ResourceInclude Source="/Themes/Components/Switch.axaml" />
        <ResourceInclude Source="/Themes/Components/ToggleButtonWithIcon.axaml" />
        <ResourceInclude Source="/Themes/Components/ColorizedButtonThemes.axaml" />
        <ResourceInclude Source="/Themes/Controls/ColorPaletteControl/ColorPaletteListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/GradientControl/GradientControlPointThumbTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/ImageSelectorControl/ImageSelectorListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/ImageSelectorControl/ImageSelectorAddButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerMiniControl/PlayerMiniResizeBorderTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerMiniControl/PlayerMiniResizeGripTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayListControl/PlayListIconButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayListControl/PlayListTextButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/SidePanelControl/SidePanelResizeThumbTemplate.axaml" />
        <ResourceInclude Source="/Themes/Controls/HamburgerMenuControl/HamburgerMenuItemButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/HamburgerMenuControl/HamburgerMenuListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/HamburgerMenuControl/HamburgerMenuListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayListControl/TracksListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayListControl/TracksListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/ControlBorderTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerControlIconButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerControlMiniButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerMiniControlButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerControlSeparatorBorder.axaml" />

        <!-- INTERNAL MESSAGES -->
        <ResourceInclude Source="/Themes/Messages/InternalMessageButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Messages/InternalMessageButtonWithIconTheme.axaml" />

        <!-- SETTINGS COMPONENTS -->
        <ResourceInclude Source="/Themes/Components/SettingsControl.axaml" />
        <ResourceInclude Source="/Themes/Components/SettingsExpandControl.axaml" />

        <!-- INTERNAL VIEW CONTROLLERS -->
        <ResourceInclude Source="/Themes/Controls/InternalViews/InternalViewController.axaml" />
        <ResourceInclude Source="/Themes/Controls/InternalViews/InternalMessageController.axaml" />

        <!-- VIEWS CONTROLS -->
        <ResourceInclude Source="/Themes/Views/InternalViewBackButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/InternalViewCloseButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/InternalViewResetButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/InternalViewSaveButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SeparatorHorizontalBorderTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SeparatorVerticalBorderTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelActionButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelListViewItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelListViewTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelContentListViewItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelContentListViewTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelTextBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/LibraryManager/LibraryItemsListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/LibraryManager/LibraryItemsListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/Settings/LibraryFoldersListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/Settings/LibraryFoldersListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/PlayListManager/NowPlayingButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/PlayListManager/TracksListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/PlayListManager/TracksListBoxTheme.axaml" />

        <!-- VIEWS -->
        <ResourceInclude Source="/Themes/Views/InternalViewBase.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessageColorPicker.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessageDialog.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessageInput.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessagePlayListPicker.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:LatinTransliterationConverter x:Key="LatinTransliterationConverter" />

    <FontFamily x:Key="ApplicationFontFamily">avares://VisualPlayer/Assets/Fonts#Oxanium, Inter</FontFamily>
    <FontFamily x:Key="ElectronicDisplayFontFamily">avares://VisualPlayer/Assets/Fonts#LED Counter 7, avares://VisualPlayer/Assets/Fonts#Oxanium, Inter</FontFamily>
    <FontFamily x:Key="Lcd14DisplayFontFamily">avares://VisualPlayer/Assets/Fonts#LED Sled, avares://VisualPlayer/Assets/Fonts#Oxanium, Inter</FontFamily>

</ResourceDictionary>
