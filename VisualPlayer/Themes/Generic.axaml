<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VisualPlayer.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VisualPlayer.UI/Themes/Generic.axaml"/>
        <!-- BASE -->

        <!-- PLAYER -->
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerPositionSliderTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerMiniPositionSliderTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerVolumeSliderTheme.axaml" />

        <!-- CUSTOM COMPONENTS -->
        <ResourceInclude Source="/Themes/Controls/PlayListItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerControlIconButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerControlMiniButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerMiniControlButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerMiniControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl/PlayerControlSeparatorBorder.axaml" />

        <!-- INTERNAL MESSAGES -->
        <ResourceInclude Source="/Themes/Messages/InternalMessageButtonTheme.axaml" />
        <ResourceInclude Source="/Themes/Messages/InternalMessageButtonWithIconTheme.axaml" />

        <!-- CONTROLS -->
        <ResourceInclude Source="/Themes/Controls/HamburgerMenuItemControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/HamburgerMenuControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/InfoBarControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/ImageSelectorControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/InternalViewController.axaml" />
        <ResourceInclude Source="/Themes/Controls/InternalMessageController.axaml" />
        <ResourceInclude Source="/Themes/Controls/LogoControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/LyricsControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/MiniVisualizationControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayerControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayListItemControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/PlayListControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/SidePanelControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/SpeedControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/VolumeControl.axaml" />
        <ResourceInclude Source="/Themes/Controls/VisualizationSurfaceControl.axaml" />

        <!-- VIEWS CONTROLS -->
        <ResourceInclude Source="/Themes/Views/InternalViewBackButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/InternalViewCloseButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/InternalViewResetButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/InternalViewSaveButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SeparatorHorizontalBorderTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SeparatorVerticalBorderTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelActionButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelListViewItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelListViewTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelContentListViewItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelContentListViewTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/SidePanelTextBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/LibraryManager/LibraryItemsListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/LibraryManager/LibraryItemsListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/Settings/LibraryFoldersListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/Settings/LibraryFoldersListBoxTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/PlayListManager/NowPlayingButtonWithIconTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/PlayListManager/TracksListBoxItemTheme.axaml" />
        <ResourceInclude Source="/Themes/Views/PlayListManager/TracksListBoxTheme.axaml" />

        <!-- VIEWS -->
        <ResourceInclude Source="/Themes/Views/InternalViewBase.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessageColorPicker.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessageDialog.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessageInput.axaml" />
        <ResourceInclude Source="/Views/Dialogs/InternalMessagePlayListPicker.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:LatinTransliterationConverter x:Key="LatinTransliterationConverter" />

    <FontFamily x:Key="ApplicationFontFamily">avares://VisualPlayer.UI/Assets/Fonts#Oxanium, Inter</FontFamily>
    <FontFamily x:Key="ElectronicDisplayFontFamily">avares://VisualPlayer.UI/Assets/Fonts#LED Counter 7, avares://VisualPlayer.UI/Assets/Fonts#Oxanium, Inter</FontFamily>
    <FontFamily x:Key="Lcd14DisplayFontFamily">avares://VisualPlayer.UI/Assets/Fonts#LED Sled, avares://VisualPlayer.UI/Assets/Fonts#Oxanium, Inter</FontFamily>

</ResourceDictionary>
