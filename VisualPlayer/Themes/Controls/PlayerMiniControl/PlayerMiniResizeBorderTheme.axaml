<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:VisualPlayer.Resources">

    <ControlTheme x:Key="PlayerMini.ResizeBorderTheme" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="{x:Static resources:Dimensions.PlayerMiniResizeHandleWidth}" />
    </ControlTheme>
</ResourceDictionary>
