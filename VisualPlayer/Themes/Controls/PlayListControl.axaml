<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:viewModels="using:VisualPlayer.ViewModels">

    <!-- THEMES OVERRIDE -->

    <ControlTheme
        x:Key="PlayList.IconButtonTheme"
        TargetType="components:ButtonWithIcon"
        BasedOn="{StaticResource ColorizedButtonWithIconTheme}">

        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="32"/>
    </ControlTheme>

    <ControlTheme
        x:Key="PlayList.TextButtonTheme"
        TargetType="components:ButtonWithIcon"
        BasedOn="{StaticResource ColorizedButtonWithIconTheme}">

        <Setter Property="Height" Value="32"/>
        <Setter Property="Gap" Value="6"/>
        <Setter Property="IconPosition" Value="Left"/>
    </ControlTheme>

    <!-- MAIN TEMPLATE -->

    <ControlTemplate
        x:Key="PlayListControlTemplate"
        x:DataType="viewModels:PlayListViewModel"
        TargetType="controls:PlayListControl">

        <Border
            x:Name="PART_PlayListHost"
            Background="Transparent"
            BorderThickness="0"
            ClipToBounds="True"
            CornerRadius="0">

            <Grid RowDefinitions="Auto,*">

                <!-- HEADER -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="6"
                    Grid.Row="0"
                    Margin="10,10,0,10">

                    <StackPanel
                        Grid.Column="0"
                        Spacing="2"
                        VerticalAlignment="Center">

                        <TextBlock
                            FontSize="12"
                            Opacity="0.5"
                            Text="Playlista"/>

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                    <components:ButtonWithIcon
                        x:Name="PART_MoreButton"
                        CornerRadius="16"
                        Grid.Column="1"
                        Height="32"
                        Kind="Ellipsis"
                        Theme="{StaticResource PlayList.IconButtonTheme}"
                        ToolTip.Tip="Opcje playlisty"
                        VerticalAlignment="Top"
                        Width="32">

                        <components:ButtonWithIcon.ContextMenu>
                            <ContextMenu
                                Placement="BottomEdgeAlignedRight">

                                <MenuItem
                                    Header="Otwórz playlistę"
                                    Tag="OpenPlaylist">
                                    
                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="FolderOpen"
                                            Size="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="Zapisz playlistę"
                                    Tag="SavePlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="Save"
                                            Size="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Header="Eksportuj playlistę"
                                    Tag="ExportPlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="FileOutput"
                                            Size="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                
                                <Separator/>

                                <MenuItem
                                    Header="Wyczyść playlistę"
                                    Tag="ClearPlaylist">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ListX"
                                            Size="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>
                                
                                <MenuItem
                                    Command="{Binding SelectCommand}"
                                    Header="{Binding SelectionButtonText}">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="ListChecks"
                                            Size="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem
                                    Command="{Binding DeleteCommand}"
                                    Header="Usuń">

                                    <MenuItem.Icon>
                                        <LucideIcon
                                            Kind="Trash"
                                            Size="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </components:ButtonWithIcon.ContextMenu>
                    </components:ButtonWithIcon>

                    <components:ButtonWithIcon
                        x:Name="PART_CloseButton"
                        CornerRadius="16"
                        Grid.Column="2"
                        Height="32"
                        Kind="X"
                        Theme="{StaticResource PlayList.IconButtonTheme}"
                        ToolTip.Tip="Zamknij"
                        VerticalAlignment="Top"
                        Width="32"/>

                </Grid>

                <!-- CONTENT -->
                <Grid
                    Grid.Column="0"
                    Grid.Row="1"
                    RowDefinitions="Auto,*"
                    HorizontalAlignment="Stretch">

                    <!-- ACTION BAR -->
                    <Border
                        BorderBrush="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                        BorderThickness="0,0,0,1"
                        Grid.Row="0"
                        Margin="10,0,0,0"
                        Padding="0,8">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">

                            <!-- SEARCH -->
                            <TextBox
                                Text="{Binding SearchPhrase, Mode=TwoWay}"
                                Theme="{StaticResource TextBoxTheme}"
                                PlaceholderText="Szukaj po tytule..."
                                VerticalAlignment="Center" />
                            
                            <!-- SORT -->
                            <components:ButtonWithIcon
                                x:Name="PART_SortButton"
                                Grid.Column="1"
                                Gap="6"
                                IconPosition="Left"
                                Kind="ArrowUpDown"
                                Theme="{StaticResource PlayList.TextButtonTheme}"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Sortuj"
                                        VerticalAlignment="Center" />

                                    <LucideIcon
                                        Kind="ChevronDown"
                                        Size="14"
                                        VerticalAlignment="Center" />

                                </StackPanel>

                                <components:ButtonWithIcon.ContextMenu>

                                    <ContextMenu
                                        Placement="BottomEdgeAlignedLeft">

                                        <!-- TITLE -->
                                        <MenuItem Header="Tytuł">

                                             <MenuItem.Icon>
                                                <LucideIcon
                                                    Kind="ALargeSmall"
                                                    Size="16"/>
                                            </MenuItem.Icon>

                                            <MenuItem
                                                Command="{Binding SortTitleAscendingCommand}"
                                                Header="Rosnąco">

                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowUpAZ"
                                                        Size="16"/>
                                                </MenuItem.Icon>

                                            </MenuItem>

                                            <MenuItem
                                                Command="{Binding SortTitleDescendingCommand}"
                                                Header="Malejąco">

                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowDownZA"
                                                        Size="16"/>
                                                </MenuItem.Icon>

                                            </MenuItem>

                                        </MenuItem>

                                        <!-- ALBUM -->
                                        <MenuItem Header="Album">

                                            <MenuItem.Icon>
                                                <LucideIcon
                                                    Kind="DiscAlbum"
                                                    Size="16"/>
                                            </MenuItem.Icon>

                                            <MenuItem
                                                Command="{Binding SortAlbumAscendingCommand}"
                                                Header="Rosnąco">

                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowUpAZ"
                                                        Size="16"/>
                                                </MenuItem.Icon>

                                            </MenuItem>

                                            <MenuItem
                                                Command="{Binding SortAlbumDescendingCommand}"
                                                Header="Malejąco">

                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowDownZA"
                                                        Size="16"/>
                                                </MenuItem.Icon>

                                            </MenuItem>

                                        </MenuItem>

                                        <!-- ARTIST -->
                                        <MenuItem Header="Artysta">
                                            
                                            <MenuItem.Icon>
                                                <LucideIcon
                                                    Kind="UserRound"
                                                    Size="16"/>
                                            </MenuItem.Icon>

                                            <MenuItem
                                                Command="{Binding SortArtistAscendingCommand}"
                                                Header="Rosnąco">

                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowUpAZ"
                                                        Size="16"/>
                                                </MenuItem.Icon>

                                            </MenuItem>

                                            <MenuItem
                                                Command="{Binding SortArtistDescendingCommand}"
                                                Header="Malejąco">

                                                <MenuItem.Icon>
                                                    <LucideIcon
                                                        Kind="ArrowDownZA"
                                                        Size="16"/>
                                                </MenuItem.Icon>

                                            </MenuItem>

                                        </MenuItem>

                                    </ContextMenu>
                                </components:ButtonWithIcon.ContextMenu>
                            </components:ButtonWithIcon>

                        </Grid>
                    </Border>

                    <!-- TRACK LIST -->
                    <ListBox
                        x:Name="PART_TrackList"
                        Background="Transparent"
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Grid.Row="1"
                        ItemContainerTheme="{StaticResource PlayListItemTheme}"
                        ItemsSource="{Binding VisibleTracks}"
                        Margin="10,0,0,10"
                        Padding="0,4,4,4"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                        SelectionMode="Single">

                        <ListBox.Styles>

                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>

                        </ListBox.Styles>

                        <ListBox.ItemTemplate>

                            <DataTemplate x:DataType="viewModels:TrackViewModel">

                                <controls:PlayListItemControl
                                    HorizontalAlignment="Stretch"/>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- DRAG PREVIEW -->
                    <Canvas
                        Grid.Row="1"
                        IsHitTestVisible="False"
                        ZIndex="10">

                        <controls:PlayListItemControl
                            x:Name="PART_DragPreview"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Opacity="0.9"/>
                    </Canvas>
                </Grid>

            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTheme
        x:Key="{x:Type controls:PlayListControl}"
        TargetType="controls:PlayListControl">

        <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
        <Setter Property="Template" Value="{StaticResource PlayListControlTemplate}"/>
    </ControlTheme>

</ResourceDictionary>
