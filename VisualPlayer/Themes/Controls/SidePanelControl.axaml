<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:resources="using:VisualPlayer.Resources">

    <ControlTemplate x:Key="SidePanel.ResizeThumbTemplate" TargetType="Thumb">
        <Border
            Background="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            CornerRadius="3"
            Height="56"
            HorizontalAlignment="Center"
            Opacity="0.65"
            VerticalAlignment="Center"
            Width="6"/>
    </ControlTemplate>

    <ControlTemplate x:Key="SidePanelControlTemplate" TargetType="controls:SidePanelControl">
        <Grid>
            <!-- Invisible trigger stays under the visible panel. -->
            <Border
                x:Name="PART_RevealArea"
                Background="Transparent"
                HorizontalAlignment="Left"
                Width="{TemplateBinding RevealSize}"/>

            <!-- The only visible panel surface. -->
            <Border
                x:Name="PART_PanelHost"
                ClipToBounds="True"
                Margin="8,0,0,0"
                Theme="{StaticResource ControlBorderTheme}">

                <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <controls:HamburgerMenuControl
                        x:Name="PART_HamburgerMenu"
                        DataContext="{TemplateBinding MenuContext}"
                        IsOpen="{Binding IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        VerticalAlignment="Stretch"/>

                    <Border
                        x:Name="PART_PlayListHost"
                        ClipToBounds="True"
                        Grid.Column="1"
                        IsHitTestVisible="False"
                        Width="{TemplateBinding PlayListHostWidth}">
                        <controls:PlayListControl
                            x:Name="PART_PlayList"
                            DataContext="{TemplateBinding PlayListDataContext}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    </Border>

                    <Thumb
                        x:Name="PART_ResizeThumb"
                        Cursor="SizeWestEast"
                        Grid.Column="2"
                        IsVisible="False"
                        Template="{StaticResource SidePanel.ResizeThumbTemplate}"
                        VerticalAlignment="Stretch"
                        Width="{x:Static resources:Dimensions.SidePanelResizeThumbWidth}"/>
                </Grid>
            </Border>

        </Grid>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type controls:SidePanelControl}" TargetType="controls:SidePanelControl">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template" Value="{StaticResource SidePanelControlTemplate}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>

        <Style Selector="^[IsPlayListOpen=True] /template/ Border#PART_PlayListHost">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <Style Selector="^[IsPlayListOpen=True] /template/ Thumb#PART_ResizeThumb">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
