<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:viewModels="using:VisualPlayer.ViewModels.Config">

    <ControlTemplate x:Key="VolumeControlTemplate" x:DataType="contexts:PlayerDataContext" TargetType="controls:VolumeControl">
        <Border
            Padding="8,16"
            Theme="{StaticResource ControlBorderTheme}">

            <Grid
                RowDefinitions="*,Auto"
                RowSpacing="16">

                <Slider
                    HorizontalAlignment="Center"
                    Maximum="{x:Static viewModels:PlayerConfig.VOLUME_MAXIMUM}"
                    Minimum="{x:Static viewModels:PlayerConfig.VOLUME_MINIMUM}"
                    Orientation="Vertical"
                    Theme="{StaticResource SliderTheme}"
                    Value="{Binding Volume, Mode=TwoWay}"
                    VerticalAlignment="Stretch"/>

                <components:ToggleButtonWithIcon
                    CheckedKind="VolumeX"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    IsChecked="{Binding IsMuted, Mode=TwoWay}"
                    Kind="Volume2"
                    Theme="{StaticResource AccentToggleButtonWithIconTheme}"
                    ToolTip.Tip="{ReflectionBinding Translations[VOLUME_TOOLTIP_MUTE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" />
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type controls:VolumeControl}" TargetType="controls:VolumeControl">
        <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        <Setter Property="Template" Value="{StaticResource VolumeControlTemplate}"/>
        <Setter Property="Width" Value="{x:Static controls:VolumeControl.WIDTH}"/>
    </ControlTheme>
</ResourceDictionary>
