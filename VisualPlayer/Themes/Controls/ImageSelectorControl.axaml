<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:configViewModels="using:VisualPlayer.ViewModels.Config">

    <converters:BackgroundImagePathToBitmapConverter x:Key="BackgroundImagePathToBitmapConverter"/>

    <ItemsPanelTemplate x:Key="BackgroundImageItemsPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <!-- DATA TEMPLATE -->

    <DataTemplate
        x:Key="BackgroundImageItemTemplate"
        DataType="configViewModels:BackgroundImageViewModel"
        x:DataType="configViewModels:BackgroundImageViewModel">

        <Grid>
            <Border
                Background="{ReflectionBinding Config.Appearance.ThemeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                CornerRadius="6"
                ClipToBounds="True">

                <Image
                    Source="{Binding Path, Converter={StaticResource BackgroundImagePathToBitmapConverter}}"
                    Stretch="UniformToFill"/>
            </Border>

            <components:ButtonWithIcon
                CornerRadius="12"
                Height="24"
                HorizontalAlignment="Right"
                IsVisible="{Binding CanRemove}"
                Kind="X"
                Margin="4"
                Padding="4"
                Tag="{Binding}"
                Theme="{StaticResource AccentButtonWithIconTheme}"
                ToolTip.Tip="Usuń obraz"
                VerticalAlignment="Top"
                Width="24"/>

            <Border
                Background="#99000000"
                CornerRadius="0,0,6,6"
                VerticalAlignment="Bottom">

                <TextBlock
                    Foreground="White"
                    Margin="6,3"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ITEM -->

    <ControlTheme x:Key="BackgroundImageItemTheme" BasedOn="{StaticResource ListBoxItemTheme}" TargetType="ListBoxItem">
        <Setter Property="Height" Value="96"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="144"/>

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeMouseOverBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="BorderBrush" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </Style>

        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeMouseOverBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="BorderBrush" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </Style>

        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemePressedBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeSelectedBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
                <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </Style>

            <Style Selector="^:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeSelectedBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
                <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </Style>

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeMouseOverBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
                <Setter Property="BorderBrush" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemePressedBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
                <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeDisabledBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </ControlTheme>

    <!-- CONTROL -->

    <ControlTemplate x:Key="ImageSelectorControlTemplate" TargetType="controls:ImageSelectorControl">
        <StackPanel Spacing="8">
            <ListBox
                x:Name="PART_ImageList"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerTheme="{StaticResource BackgroundImageItemTheme}"
                ItemTemplate="{StaticResource BackgroundImageItemTemplate}"
                ItemsPanel="{StaticResource BackgroundImageItemsPanel}"
                ItemsSource="{ReflectionBinding Images, RelativeSource={RelativeSource TemplatedParent}}"
                Padding="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="Single"/>

            <components:ButtonWithIcon
                x:Name="PART_AddImageButton"
                Content="Dodaj obraz"
                HorizontalContentAlignment="Center"
                IconPosition="Top"
                Height="88"
                Kind="Plus"
                Margin="8,4,8,4"
                Padding="12,8"
                Theme="{StaticResource AccentButtonWithIconTheme}"
                ToolTip.Tip="Dodaj obraz"
                Width="136"/>
        </StackPanel>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type controls:ImageSelectorControl}" TargetType="controls:ImageSelectorControl">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource ImageSelectorControlTemplate}"/>
    </ControlTheme>

</ResourceDictionary>
