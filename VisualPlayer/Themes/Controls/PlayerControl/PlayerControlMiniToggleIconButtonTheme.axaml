<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components">

    <ControlTheme x:Key="PlayerControl.MiniToggleIconButtonTheme" TargetType="components:ToggleButtonWithIcon" BasedOn="{StaticResource ColorizedToggleButtonWithIconTheme}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="24"/>

        <Style Selector="^:checked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>
