<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts">

    <ControlTheme x:Key="PlayerControl.SeparatorBorder" TargetType="Border">
        <Setter Property="Background" Value="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        <Setter Property="Height" Value="24"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="1"/>
    </ControlTheme>
</ResourceDictionary>
