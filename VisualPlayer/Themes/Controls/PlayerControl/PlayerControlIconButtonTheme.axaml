<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components">

    <!-- BUTTON WITH ICON -->

    <ControlTheme x:Key="PlayerControl.IconButtonTheme" TargetType="components:ButtonWithIcon" BasedOn="{StaticResource ColorizedButtonWithIconTheme}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Width" Value="48"/>
    </ControlTheme>

    <!-- TOGGLE BUTTON WITH ICON -->

    <ControlTheme x:Key="PlayerControl.ToggleIconButtonTheme" TargetType="components:ToggleButtonWithIcon" BasedOn="{StaticResource ColorizedToggleButtonWithIconTheme}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Width" Value="48"/>
    </ControlTheme>

</ResourceDictionary>
