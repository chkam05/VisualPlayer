<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VisualPlayer.Controls">

    <ControlTemplate x:Key="LogoControlTemplate" TargetType="controls:LogoControl">
        <Viewbox
            x:Name="PART_Logo"
            Height="{TemplateBinding RenderedLogoHeight}"
            Stretch="Uniform"
            Width="{TemplateBinding RenderedLogoWidth}">

            <Canvas
                Height="45.827179"
                Width="52.917084">

                <!-- PLAYER -->
                <Path
                    Data="M 12.135386,0.132291 L 15.571869,6.085416 41.313451,6.085416 30.438145,24.921993 34.406895,31.795992 42.351018,45.562593 50.299650,45.562593 38.382291,24.910058 52.687949,0.132291 Z"
                    Fill="{TemplateBinding PlayerFill}"
                    Stroke="{TemplateBinding PlayerBorder}"
                    StrokeThickness="0.45"/>

                <!-- VISUAL -->
                <Path
                    Data="M 0.229136,0.132291 L 26.458543,45.562593 32.411668,35.251595 28.442918,28.377595 26.458543,31.814595 12.640265,7.880655 11.603636,6.085416 8.166636,0.132291 Z"
                    Fill="{TemplateBinding VisualFill}"
                    Stroke="{TemplateBinding VisualBorder}"
                    StrokeThickness="0.45"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type controls:LogoControl}" TargetType="controls:LogoControl">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template" Value="{StaticResource LogoControlTemplate}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </ControlTheme>
</ResourceDictionary>
