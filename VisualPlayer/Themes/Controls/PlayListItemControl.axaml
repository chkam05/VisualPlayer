<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:viewModels="using:VisualPlayer.ViewModels">

    <ControlTemplate
        x:Key="PlayListItemControlTemplate"
        x:DataType="viewModels:TrackViewModel"
        TargetType="controls:PlayListItemControl">

        <Border
            Background="Transparent"
            CornerRadius="6"
            MinHeight="64"
            Padding="6">

            <Grid
                ColumnDefinitions="Auto,Auto,48,*,Auto,Auto"
                ColumnSpacing="10">

                <Border
                    x:Name="PART_DropBefore"
                    Background="{ReflectionBinding Config.Appearance.AccentColorBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Grid.ColumnSpan="6"
                    Height="2"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Margin="0,-7,0,0"
                    VerticalAlignment="Top"/>

                <Border
                    x:Name="PART_DropAfter"
                    Background="{ReflectionBinding Config.Appearance.AccentColorBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    Grid.ColumnSpan="6"
                    Height="2"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Margin="0,0,0,-7"
                    VerticalAlignment="Bottom"/>

                <!-- REORDER HANDLER -->
                <Border
                    x:Name="PART_ReorderHandle"
                    Background="Transparent"
                    Cursor="Hand"
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Width="18">

                    <LucideIcon
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Kind="GripVertical"
                        Opacity="0.55"
                        Size="18"
                        VerticalAlignment="Center"/>
                </Border>

                <!-- CHECKBOX -->
                <CheckBox
                    Grid.Column="1"
                    IsVisible="{Binding IsSelectionMode}"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    VerticalAlignment="Center"/>
                
                <!-- COVER -->
                <Border
                    Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    ClipToBounds="True"
                    CornerRadius="5"
                    Grid.Column="2"
                    Height="48"
                    Width="48">

                    <Grid>

                        <!-- Icon fallback -->
                        <LucideIcon
                            Foreground="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            Kind="Music"
                            Opacity="0.35"
                            Size="20"
                            VerticalAlignment="Center"/>

                        <!-- Cover -->
                        <Image
                            Source="{Binding Cover}"
                            Stretch="UniformToFill"/>

                        <!-- Currently playing overlay -->
                        <Border
                            Background="{ReflectionBinding Config.Appearance.ThemeShadeBackgroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                            IsVisible="{Binding IsCurrentPlaying}">

                            <LucideIcon
                                Foreground="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                Kind="Play"
                                Size="20"
                                VerticalAlignment="Center"/>

                        </Border>
                    </Grid>
                </Border>

                <!-- TITLE / ALBUM / ARTIST -->
                <StackPanel
                    Grid.Column="3"
                    ClipToBounds="True"
                    Spacing="3"
                    VerticalAlignment="Center">

                    <!-- Title -->
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"/>

                    <Grid
                        ColumnDefinitions="*,Auto,*"
                        ColumnSpacing="4"
                        HorizontalAlignment="Left">

                        <!-- Album -->
                        <TextBlock
                            FontSize="12"
                            Opacity="0.65"
                            Text="{Binding Album}"
                            TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                            FontSize="12"
                            Grid.Column="1"
                            Opacity="0.4"
                            Text="/"/>

                        <!-- Artist -->
                        <TextBlock
                            FontSize="12"
                            Grid.Column="2"
                            Opacity="0.65"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis"/>

                    </Grid>
                </StackPanel>

                <!-- DURATION -->
                <TextBlock
                    FontSize="12"
                    Grid.Column="4"
                    Margin="10,0"
                    Opacity="0.7"
                    Text="{Binding DurationText}"
                    VerticalAlignment="Center"/>
                
                <!-- OPTIONS -->
                <components:ButtonWithIcon
                    x:Name="PART_OptionsButton"
                    CornerRadius="16"
                    Grid.Column="5"
                    Height="32"
                    Kind="Ellipsis"
                    Theme="{StaticResource ColorizedButtonWithIconTheme}"
                    ToolTip.Tip="{ReflectionBinding Translations[COMMON_BUTTON_OPTIONS], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Width="32">

                    <components:ButtonWithIcon.ContextMenu>
                        <ContextMenu>

                            <MenuItem
                                Header="{ReflectionBinding Translations[COMMON_BUTTON_OPEN], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="Play">

                                <MenuItem.Icon>
                                    <LucideIcon
                                        Kind="Play"
                                        Size="16"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <MenuItem Header="{ReflectionBinding Translations[COMMON_MOVE_UP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" Tag="MoveUp">
                                <MenuItem.Icon><LucideIcon Kind="ArrowUp" Size="16"/></MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="{ReflectionBinding Translations[COMMON_MOVE_DOWN], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" Tag="MoveDown">
                                <MenuItem.Icon><LucideIcon Kind="ArrowDown" Size="16"/></MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="{ReflectionBinding Translations[PLAYLIST_ITEM_ITEM_MOVE_TO_THE_VERY_TOP], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" Tag="MoveTop">
                                <MenuItem.Icon><LucideIcon Kind="ChevronsUp" Size="16"/></MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="{ReflectionBinding Translations[PLAYLIST_ITEM_ITEM_MOVE_TO_THE_VERY_BOTTOM], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}" Tag="MoveBottom">
                                <MenuItem.Icon><LucideIcon Kind="ChevronsDown" Size="16"/></MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <MenuItem
                                Header="{ReflectionBinding Translations[COMMON_BUTTON_DELETE], Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
                                Tag="Remove">

                                <MenuItem.Icon>
                                    <LucideIcon
                                        Kind="Trash"
                                        Size="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </components:ButtonWithIcon.ContextMenu>
                </components:ButtonWithIcon>
            
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTheme
        x:Key="{x:Type controls:PlayListItemControl}"
        TargetType="controls:PlayListItemControl">
        
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource PlayListItemControlTemplate}" />

        <Style Selector="^:drop-before /template/ Border#PART_DropBefore">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^:drop-after /template/ Border#PART_DropAfter">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

    </ControlTheme>

</ResourceDictionary>
