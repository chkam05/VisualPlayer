<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components">

    <ControlTheme x:Key="PlayList.TextButtonTheme" TargetType="components:ButtonWithIcon" BasedOn="{StaticResource ColorizedButtonWithIconTheme}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Gap" Value="6" />
        <Setter Property="IconPosition" Value="Left" />
    </ControlTheme>
</ResourceDictionary>
