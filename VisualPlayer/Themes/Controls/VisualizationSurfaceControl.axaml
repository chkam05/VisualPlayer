<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:controls="using:VisualPlayer.Controls">

    <ControlTemplate x:Key="VisualizationSurfaceControlTemplate" TargetType="controls:VisualizationSurfaceControl">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">

            <Grid/>
        </Border>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type controls:VisualizationSurfaceControl}" TargetType="controls:VisualizationSurfaceControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.AccentColorBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        <Setter Property="Template" Value="{StaticResource VisualizationSurfaceControlTemplate}" />
    </ControlTheme>
</ResourceDictionary>
