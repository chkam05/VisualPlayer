<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts">

    <ControlTemplate x:Key="SidePanel.ResizeThumbTemplate" TargetType="Thumb">
        <Border
            Background="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"
            CornerRadius="3"
            Height="56"
            HorizontalAlignment="Center"
            Opacity="0.65"
            VerticalAlignment="Center"
            Width="6" />
    </ControlTemplate>
</ResourceDictionary>
