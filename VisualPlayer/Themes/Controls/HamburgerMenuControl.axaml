<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:contexts="using:VisualPlayer.Contexts"
    xmlns:resources="using:VisualPlayer.Resources">

    <!-- DATA TEMPLATE -->
    <DataTemplate x:Key="HamburgerMenuItemTemplate">
        <controls:HamburgerMenuItemControl
            HorizontalAlignment="Stretch"
            IsMenuOpen="{ReflectionBinding IsOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:HamburgerMenuControl}}}"/>
    </DataTemplate>

    <!-- CONTROL TEMPLATE -->
    <ControlTemplate x:Key="HamburgerMenuControlTemplate" x:DataType="contexts:HamburgerMenuContext" TargetType="controls:HamburgerMenuControl">
        <Border
            x:Name="PART_MenuHost"
            Background="Transparent"
            BorderThickness="0"
            ClipToBounds="True"
            HorizontalAlignment="Left"
            Padding="4,2"
            Width="56">

            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Property="Width"
                        Duration="{x:Static resources:Dimensions.SidePanelAnimationDuration}"/>
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="Auto,*,Auto">
                <ItemsControl
                    x:Name="PART_TopItemsControl"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource HamburgerMenuItemTemplate}"
                    ItemsSource="{Binding TopItems}"/>

                <ItemsControl
                    x:Name="PART_BottomItemsControl"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource HamburgerMenuItemTemplate}"
                    ItemsSource="{Binding BottomItems}"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- CONTROL THEME -->
    <ControlTheme x:Key="{x:Type controls:HamburgerMenuControl}" TargetType="controls:HamburgerMenuControl">
        <Setter Property="Foreground" Value="{ReflectionBinding Config.Appearance.ThemeForegroundBrush, Source={x:Static contexts:ApplicationContext.Instance}, Mode=OneWay}"/>
        <Setter Property="Template" Value="{StaticResource HamburgerMenuControlTemplate}"/>

        <Style Selector="^[IsOpen=True] /template/ Border#PART_MenuHost">
            <Setter Property="Width" Value="240"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
