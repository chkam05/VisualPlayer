<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="InternalMessage.ButtonTheme" BasedOn="{StaticResource AccentButtonTheme}" TargetType="Button">
        <Setter Property="MinWidth" Value="88"/>
    </ControlTheme>

</ResourceDictionary>
