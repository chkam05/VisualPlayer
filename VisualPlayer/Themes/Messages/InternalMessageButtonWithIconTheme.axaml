<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components">

    <ControlTheme x:Key="InternalMessage.ButtonWithIconTheme" BasedOn="{StaticResource AccentButtonWithIconTheme}" TargetType="components:ButtonWithIcon">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="32"/>
    </ControlTheme>

</ResourceDictionary>
