<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="SidePanelContent.ListBoxItemTheme" BasedOn="{StaticResource SidePanel.ListBoxItemTheme}" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="46"/>
    </ControlTheme>

</ResourceDictionary>
