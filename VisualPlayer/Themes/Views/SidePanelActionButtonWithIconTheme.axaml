<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components">

    <ControlTheme x:Key="SidePanel.ActionButtonWithIconTheme" BasedOn="{StaticResource AccentButtonWithIconTheme}" TargetType="components:ButtonWithIcon">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="42"/>
    </ControlTheme>

</ResourceDictionary>
