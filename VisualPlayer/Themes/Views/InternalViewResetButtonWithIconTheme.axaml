<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components">

    <ControlTheme x:Key="InternalView.ResetButtonWithIconTheme" BasedOn="{StaticResource AccentButtonWithIconTheme}" TargetType="components:ButtonWithIcon">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </ControlTheme>

</ResourceDictionary>
