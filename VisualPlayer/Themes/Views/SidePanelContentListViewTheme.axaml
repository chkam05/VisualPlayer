<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="SidePanelContent.ListBoxTheme" BasedOn="{StaticResource SidePanel.ListBoxTheme}" TargetType="ListBox">
        <Setter Property="ItemContainerTheme" Value="{StaticResource SidePanelContent.ListBoxItemTheme}"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Width" Value="280"/>
    </ControlTheme>

</ResourceDictionary>
