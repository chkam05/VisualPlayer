<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VisualPlayer.Converters">

    <ControlTheme x:Key="ControlBorderTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource UI.ThemeShadeBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>

        <Setter Property="Background">
            <DynamicResource ResourceKey="UI.ControlSurfaceBrush"/>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
