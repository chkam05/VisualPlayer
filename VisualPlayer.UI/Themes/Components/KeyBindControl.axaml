<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:contexts="using:VisualPlayer.Contexts">

    <ControlTemplate x:Key="KeyBindControlTemplate" TargetType="components:KeyBindControl">
        <Grid
            ColumnDefinitions="128,40"
            ColumnSpacing="8">

            <Button
                x:Name="PART_InputButton"
                Content="{TemplateBinding Gesture}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Theme="{StaticResource AccentButtonTheme}"
                ToolTip.Tip="{DynamicResource UI.Text.KEYBIND_TITLE}"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Center" />

            <components:ButtonWithIcon
                x:Name="PART_ClearButton"
                Grid.Column="1"
                Height="40"
                Kind="X"
                Theme="{StaticResource AccentButtonWithIconTheme}"
                ToolTip.Tip="{DynamicResource UI.Text.KEYBIND_BUTTON_CLEAN}"
                Width="40"/>
        </Grid>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type components:KeyBindControl}" TargetType="components:KeyBindControl">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template" Value="{StaticResource KeyBindControlTemplate}"/>

        <Style Selector="^:capturing /template/ Button#PART_InputButton">
            <Setter Property="Content" Value="{DynamicResource UI.Text.KEYBIND_CAPTURING}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UI.AccentColorBrush}"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
