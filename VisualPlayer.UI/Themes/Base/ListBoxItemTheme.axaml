<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts">

    <ControlTheme x:Key="ListBoxItemTheme" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource UI.ThemeForegroundBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UI.AccentMouseOverColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
        </Style>

        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UI.AccentMouseOverColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
        </Style>

        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UI.AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource UI.AccentSelectedColorBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
            </Style>

            <Style Selector="^:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource UI.AccentSelectedColorBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
            </Style>

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource UI.AccentMouseOverColorBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource UI.AccentPressedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UI.ThemeDisabledBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource UI.ThemeForegroundBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
