<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contexts="using:VisualPlayer.Contexts">

    <StreamGeometry x:Key="ContextMenuItem.Chevron">M 1,0 10,10 L 1,20 0,19 8,10 0,1 Z</StreamGeometry>

    <ControlTemplate x:Key="ContextMenuItemTemplate" TargetType="MenuItem">
        <Panel>
            <Border
                x:Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <Grid
                        x:Name="PART_TogglePresenter"
                        Grid.Column="0"
                        Height="18"
                        IsVisible="False"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Width="18">

                        <LucideIcon
                            x:Name="PART_CheckBoxUncheckedIcon"
                            Kind="Square"
                            Size="18"/>

                        <LucideIcon
                            x:Name="PART_CheckBoxCheckedIcon"
                            Foreground="{DynamicResource UI.AccentColorBrush}"
                            IsVisible="False"
                            Kind="SquareCheck"
                            Size="18"/>

                        <LucideIcon
                            x:Name="PART_RadioUncheckedIcon"
                            IsVisible="False"
                            Kind="Circle"
                            Size="18"/>

                        <LucideIcon
                            x:Name="PART_RadioCheckedIcon"
                            Foreground="{DynamicResource UI.AccentColorBrush}"
                            IsVisible="False"
                            Kind="CircleCheck"
                            Size="18"/>
                    </Grid>

                    <ContentControl
                        x:Name="PART_IconPresenter"
                        Content="{TemplateBinding Icon}"
                        Grid.Column="1"
                        Height="18"
                        IsVisible="False"
                        Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        Width="18"/>

                    <ContentPresenter
                        x:Name="PART_HeaderPresenter"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        RecognizesAccessKey="True"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="PART_InputGestureText"
                        Grid.Column="3"
                        Margin="24,0,0,0"
                        Opacity="0.65"
                        Text="{TemplateBinding InputGesture}"
                        VerticalAlignment="Center"/>

                    <Path
                        x:Name="PART_ChevronPath"
                        Data="{StaticResource ContextMenuItem.Chevron}"
                        Fill="{TemplateBinding Foreground}"
                        Grid.Column="4"
                        Height="12"
                        Margin="14,0,2,0"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        Width="6"/>
                </Grid>
            </Border>

            <Popup
                x:Name="PART_Popup"
                HorizontalOffset="-4"
                IsLightDismissEnabled="False"
                IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                Placement="RightEdgeAlignedTop"
                WindowManagerAddShadowHint="False">

                <Border
                    Background="{DynamicResource UI.ThemeShadeBackgroundBrush}"
                    BorderBrush="{DynamicResource UI.ThemeBackgroundBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MinWidth="180"
                    Padding="4">

                    <ScrollViewer Theme="{StaticResource FluentMenuScrollViewer}">
                        <ItemsPresenter
                            x:Name="PART_ItemsPresenter"
                            Grid.IsSharedSizeScope="True"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Panel>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource UI.ThemeShadeBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UI.ThemeBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource UI.ThemeForegroundBrush}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template" Value="{StaticResource ContextMenuItemTemplate}"/>

        <Style Selector="^:icon /template/ ContentControl#PART_IconPresenter">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[ToggleType=CheckBox] /template/ Grid#PART_TogglePresenter">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[ToggleType=CheckBox]:checked /template/ LucideIcon#PART_CheckBoxUncheckedIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="^[ToggleType=CheckBox]:checked /template/ LucideIcon#PART_CheckBoxCheckedIcon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[ToggleType=Radio] /template/ Grid#PART_TogglePresenter">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[ToggleType=Radio] /template/ LucideIcon#PART_CheckBoxUncheckedIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="^[ToggleType=Radio] /template/ LucideIcon#PART_RadioUncheckedIcon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^[ToggleType=Radio]:checked /template/ LucideIcon#PART_RadioUncheckedIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="^[ToggleType=Radio]:checked /template/ LucideIcon#PART_RadioCheckedIcon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>

            <Style Selector="^ /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource UI.AccentMouseOverColorBrush}"/>
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>

            <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
                <Setter Property="Background" Value="{DynamicResource UI.AccentPressedBrush}"/>
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource UI.ThemeForegroundBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>

            <Style Selector="^ /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource UI.ThemeDisabledBrush}"/>
            </Style>
        </Style>

        <Style Selector="^:empty /template/ Path#PART_ChevronPath">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="^:open">
            <Setter Property="Foreground" Value="{DynamicResource UI.AccentForegroundColorBrush}"/>

            <Style Selector="^ /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource UI.AccentSelectedColorBrush}"/>
            </Style>
        </Style>

        <Style Selector="^:separator">
            <Setter Property="Template">
                <ControlTemplate>
                    <Separator Margin="8,4"/>
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
