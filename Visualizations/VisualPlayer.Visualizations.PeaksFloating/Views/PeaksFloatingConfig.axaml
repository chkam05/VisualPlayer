<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plugins="using:VisualPlayer.VisualizationBase.Plugins"
    xmlns:components="using:VisualPlayer.Components"
    xmlns:common="using:VisualPlayer.UI.Views"
    xmlns:controls="using:VisualPlayer.Controls"
    xmlns:converters="using:VisualPlayer.Converters"
    xmlns:config="using:VisualPlayer.Visualizations.PeaksFloating.Config"
    xmlns:visualizationConfig="using:VisualPlayer.Visualizations.Config.Base"
    x:Class="VisualPlayer.Visualizations.PeaksFloating.Views.PeaksFloatingConfig"
    x:DataType="plugins:VisualizationEditorContext"
    x:Name="Root">

    <UserControl.Resources>
        <converters:VisualizationDirectionToTitleConverter x:Key="VisualizationDirectionToTitleConverter"/>
    </UserControl.Resources>

    <StackPanel
        Orientation="Vertical"
        Spacing="8">

        <!-- Color -->
        <common:VisualisationColorEditor EditorContext="{Binding}"/>

        <!-- Number of peaks -->
        <controls:SettingsControl
            Description="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_NUM_DESC], Mode=OneWay}"
            Icon="ChartNoAxesColumn"
            Title="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_NUM_TITLE], Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BARS_COUNT_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BARS_COUNT_MINIMUM}"
                Value="{ReflectionBinding Configuration.PeaksCount, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Direction -->
        <controls:SettingsControl
            Description="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_DIRECTION_DESC], Mode=OneWay}"
            Icon="ArrowUpDown"
            Title="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_DIRECTION_TITLE], Mode=OneWay}">

            <ComboBox
                ItemsSource="{Binding Directions, ElementName=Root}"
                SelectedValueBinding="{ReflectionBinding Value}"
                SelectedValue="{ReflectionBinding Configuration.Direction, Mode=TwoWay}"
                Theme="{StaticResource ComboBoxTheme}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource VisualizationDirectionToTitleConverter}">
                                    <ReflectionBinding Path="Value"/>
                                    <ReflectionBinding Path="Translations"/>
                                    <ReflectionBinding Path="Translations.CurrentLanguageCode"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsControl>

        <!-- Horizontal spacing -->
        <controls:SettingsControl
            Description="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_HORIZONTAL_BAR_SPACE_DESC], Mode=OneWay}"
            Icon="BetweenVerticalStart"
            Title="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_HORIZONTAL_BAR_SPACE_TITLE], Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_SPACE_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_SPACE_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Configuration.HorizontalBarSpace, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Peak height -->
        <controls:SettingsControl
            Description="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_BAR_HEIGHT_DESC], Mode=OneWay}"
            Icon="MoveVertical"
            Title="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_BAR_HEIGHT_TITLE], Mode=OneWay}">

            <components:NumericUpDown
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_HEIGHT_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.BAR_HEIGHT_MINIMUM}"
                Suffix=" px"
                Value="{ReflectionBinding Configuration.BarHeight, Mode=TwoWay}"/>
        </controls:SettingsControl>

        <!-- Falling speed -->
        <controls:SettingsControl
            Description="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_PEAKS_DESCENT_RATE_DESC], Mode=OneWay}"
            Icon="ClockFading"
            Title="{ReflectionBinding Services.Translations[VIEW_VISUALIZATIONS_DESCENT_RATE_TITLE], Mode=OneWay}">

            <components:NumericUpDown
                Increment="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_INCREMENT}"
                Maximum="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_MAXIMUM}"
                Minimum="{x:Static visualizationConfig:VisualizationBaseConfig.DESCENT_RATE_MINIMUM}"
                Suffix=" px/s"
                Value="{ReflectionBinding Configuration.DescentRate, Mode=TwoWay}"/>
        </controls:SettingsControl>
        
    </StackPanel>
</UserControl>
